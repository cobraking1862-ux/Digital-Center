<Window x:Class="DigitalCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DigitalCenter.ViewModels;assembly=DigitalCenter.ViewModels"
        xmlns:views="clr-namespace:DigitalCenter.App.Views"
        xmlns:conv="clr-namespace:DigitalCenter.App.Converters"
        Title="DigitalCenter"
        Width="1380"
        Height="840"
        MinWidth="1020"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DramaViewModel}">
            <views:DramaPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DramaDetailsViewModel}">
            <views:DramaDetailsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LookupViewModel}">
            <views:LookupPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TicketsViewModel}">
            <views:TicketsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsbCartViewModel}">
            <views:UsbCartPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagementViewModel}">
            <views:ManagementPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceViewModel}">
            <views:MaintenancePage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
            <views:DetailsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= Clean Light Caption Bar ================= -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Width="36" Height="32"
                        Focusable="False"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnHamburgerClick"
                        Margin="10,0,0,0"
                        ToolTip="Toggle navigation sidebar"
                        AutomationProperties.Name="Toggle sidebar">
                    <TextBlock Text="{StaticResource Icon.Hamburger}" Style="{StaticResource GlyphIcon}" FontSize="16"
                               Foreground="{StaticResource TextBrush}"/>
                </Button>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Border Width="24" Height="24" CornerRadius="5" Background="{StaticResource PrimaryBrush}" VerticalAlignment="Center">
                        <TextBlock Text="{StaticResource Icon.Play}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="DigitalCenter" Style="{StaticResource AppTitle}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <TextBlock Text="{StaticResource Icon.Minimize}" FontSize="11"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Grid>
                            <TextBlock Text="{StaticResource Icon.Maximize}" FontSize="11"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{StaticResource Icon.Restore}" FontSize="11"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       Foreground="{StaticResource TextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" ToolTip="Close"
                            AutomationProperties.Name="Close" Margin="0,0,6,0">
                        <TextBlock Text="{StaticResource Icon.Close}" FontSize="11"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ Body ======================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Simplified Navigation Sidebar -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{StaticResource SidebarBackground}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,1,0"
                    Width="220">
                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListBoxItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,12,0,12"
                         VerticalAlignment="Top"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="OnNavListPreviewMouseLeftButtonDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="5"
                                        Background="Transparent" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Glyph}"
                                               Style="{StaticResource GlyphIcon}" FontSize="16"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}"
                                           FontSize="13.5" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                           Margin="10,0,0,0"
                                           ToolTip="{Binding Title}"
                                           Visibility="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                <Border Grid.Column="2" Background="{StaticResource PrimaryBrush}"
                                        CornerRadius="4" Padding="6,1.5" VerticalAlignment="Center"
                                        Margin="6,0,2,0"
                                        Visibility="{Binding BadgeCount, Converter={StaticResource CountToVis}}">
                                    <TextBlock Text="{Binding BadgeCount}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Page Content -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Margin="0"/>
        </Grid>
    </Grid>
</Window>
