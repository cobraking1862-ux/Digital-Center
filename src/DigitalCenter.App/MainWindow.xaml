<Window x:Class="DigitalCenter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:DigitalCenter.ViewModels;assembly=DigitalCenter.ViewModels"
        xmlns:views="clr-namespace:DigitalCenter.App.Views"
        xmlns:conv="clr-namespace:DigitalCenter.App.Converters"
        Title="DigitalCenter 5.0"
        Width="1440"
        Height="860"
        MinWidth="1060"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource WindowBackground}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:CountToVisibilityConverter x:Key="CountToVis"/>
        <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
            <views:LibraryPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsbCartViewModel}">
            <views:UsbCartPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManagementViewModel}">
            <views:ManagementPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DetailsViewModel}">
            <views:DetailsPage Style="{StaticResource PageFadeStyle}"/>
        </DataTemplate>
    </Window.Resources>

    <!-- ======================= aurora canvas (Mica-inspired) =================
         Base obsidian gradient + two softly diffused accent glows + a faint
         violet wash. Glows are plain radial gradients: diffuse by nature, so
         no BlurEffect cost anywhere in the visual tree. -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#060609" Offset="0"/>
                <GradientStop Color="#0B0A12" Offset="0.52"/>
                <GradientStop Color="#090810" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.06,-0.04" GradientOrigin="0.06,-0.04" RadiusX="0.85" RadiusY="0.7">
                    <GradientStop Color="#577C3AED" Offset="0"/>
                    <GradientStop Color="#007C3AED" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="1.0,1.06" GradientOrigin="1.0,1.06" RadiusX="0.9" RadiusY="0.75">
                    <GradientStop Color="#380891B2" Offset="0"/>
                    <GradientStop Color="#000891B2" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.6" RadiusY="0.5">
                    <GradientStop Color="#1A4C1D95" Offset="0"/>
                    <GradientStop Color="#004C1D95" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= custom Fluent caption bar ================= -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- The single hamburger control (opens/closes the sidebar) -->
                <Button Grid.Column="0"
                        Style="{StaticResource IconButton}"
                        Width="38" Height="34"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="OnHamburgerClick"
                        Margin="10,0,0,0"
                        ToolTip="Toggle sidebar"
                        AutomationProperties.Name="Toggle sidebar">
                    <TextBlock Text="{StaticResource Icon.Hamburger}" Style="{StaticResource GlyphIcon}"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>

                <!-- Brand -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Grid Width="27" Height="27" VerticalAlignment="Center">
                        <Border CornerRadius="{StaticResource Radius.Control}" Background="{StaticResource AccentGradient}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="#7C3AED"/>
                            </Border.Effect>
                        </Border>
                        <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource GlyphXs}"
                                   Foreground="White" Margin="1,0,0,0"/>
                    </Grid>
                    <TextBlock Text="DigitalCenter" Style="{StaticResource AppTitle}" Margin="11,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Background="#268B5CF6" BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Xs}" Padding="8,3" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="5.0" FontSize="10.5" FontWeight="SemiBold" Foreground="#D9C9FF"/>
                    </Border>
                </StackPanel>

                <!-- Window controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimize"
                            AutomationProperties.Name="Minimize">
                        <TextBlock Text="{StaticResource Icon.Minimize}" Style="{StaticResource GlyphXs}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButton}" Click="OnMaximizeRestoreClick" ToolTip="Maximize"
                            AutomationProperties.Name="Maximize">
                        <Grid>
                            <TextBlock Text="{StaticResource Icon.Maximize}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphXs}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{StaticResource Icon.Restore}"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource GlyphXs}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" ToolTip="Close"
                            AutomationProperties.Name="Close" Margin="0,0,8,0">
                        <TextBlock Text="{StaticResource Icon.Close}" Style="{StaticResource GlyphXs}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================================ body ======================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Glass navigation rail -->
                <Border x:Name="Sidebar"
                        Grid.Column="0"
                        Background="{StaticResource SidebarSurface}"
                        BorderBrush="#1FFFFFFF"
                        BorderThickness="0,0,1,0"
                        Width="248">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Library" Style="{StaticResource EyebrowText}"
                                   Margin="26,16,16,10"
                                   Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNavItem, Mode=TwoWay}"
                                 PreviewMouseLeftButtonUp="OnNavRowClick"
                                 ItemContainerStyle="{StaticResource NavListBoxItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Margin="0,2,0,0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="IconChipHost"
                                                Width="{StaticResource IconChipSize}" Height="{StaticResource IconChipSize}"
                                                CornerRadius="{StaticResource Radius.Tile}"
                                                Background="#22FFFFFF" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Glyph}"
                                                       Style="{StaticResource GlyphIcon}"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center"
                                                   Margin="12,0,0,0"
                                                   ToolTip="{Binding Title}"
                                                   Visibility="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <!-- Cart badge: rectangular counter -->
                                        <Border x:Name="CartBadge" Grid.Column="2" Background="{StaticResource AccentGradient}"
                                                CornerRadius="{StaticResource Radius.Xs}" Padding="7,2" VerticalAlignment="Center"
                                                Margin="8,0,2,0"
                                                Visibility="{Binding BadgeCount, Converter={StaticResource CountToVis}}">
                                            <TextBlock Text="{Binding BadgeCount}" FontSize="10.5" FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                            <Setter TargetName="IconChipHost" Property="Background" Value="{StaticResource AccentGradientSoft}"/>
                                            <Setter TargetName="IconChipHost" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                                        </DataTrigger>
                                        <!-- Collapsed rail: only the icon fits, so the
                                             counter hides instead of being clipped. -->
                                        <DataTrigger Binding="{Binding DataContext.IsSidebarOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                            <Setter TargetName="CartBadge" Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Footer: version card -->
                        <StackPanel Grid.Row="2" Margin="14,0,14,14"
                                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}">
                            <Separator Style="{StaticResource Divider}" Margin="8,4,8,10"/>
                            <Border Background="#1FFFFFFF" CornerRadius="{StaticResource Radius.Card}" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DigitalCenter" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="Obsidian Aurora · 5.0.0" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Ellipse Grid.Column="1" Width="8" Height="8" VerticalAlignment="Center">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush>
                                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                                <GradientStop Color="#22D3EE" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page content (pages fade in through their own Loaded trigger) -->
                <ContentControl Grid.Column="1"
                                Content="{Binding CurrentPage}"
                                Margin="0"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
