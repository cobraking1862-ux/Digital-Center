<UserControl x:Class="DigitalCenter.App.Views.DetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:PosterPathToImageConverter x:Key="PosterToImage"/>

        <!-- One action button in the fixed top bar: icon + label, identical
             metrics everywhere so the bar never looks assembled from leftovers. -->
        <Style x:Key="ActionBarButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="{StaticResource ControlPaddingCompact}"/>
        </Style>
    </UserControl.Resources>

    <!-- ==================================================================
         Two independent areas, no nested scrolling:

         Row 0  action bar      - fixed, always reachable
         Row 1  hero            - fixed: backdrop, poster, title, overview
         Row 2  ScrollViewer    - the only scrolling region: editor or the
                                  cast / seasons / episodes / files sections

         The hero used to live INSIDE the scroll region (pulled up over the
         backdrop with a -240 margin), so the title and poster scrolled away
         and two scrollable areas fought each other. They are separate now.
         ================================================================== -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==================== fixed action bar ==================== -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="28,11,28,11">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource ActionBarButton}" Margin="0"
                        Command="{Binding BackCommand}"
                        ToolTip="Back to the library"
                        AutomationProperties.Name="Back to library">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Back}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                        <TextBlock Text="Back to Library" FontSize="13"/>
                    </StackPanel>
                </Button>

                <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource CaptionText}"
                           VerticalAlignment="Center" Margin="18,0,18,0" TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center" MaxWidth="420" ToolTip="{Binding Title}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverted}}">
                    <Button Style="{StaticResource ActionBarButton}"
                            Command="{Binding StartEditCommand}"
                            ToolTip="Edit the stored metadata for this title">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Edit}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                            <TextBlock Text="Edit Metadata" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBarButton}"
                            Command="{Binding RefreshFromTmdbCommand}"
                            ToolTip="Re-read this title from TMDb (manual edits are kept)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Refresh}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                            <TextBlock Text="Refresh from TMDb" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionBarButton}" Margin="0"
                            Command="{Binding AddToCartCommand}"
                            ToolTip="Queue every registered file of this title for the USB cart">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Cart}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                            <TextBlock Text="Add to USB Cart" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== fixed hero ====================
             Backdrop + poster + title block. Stays put while row 2 scrolls.
             Missing artwork falls back to the placeholder tile, a long title
             wraps inside its column, and a long overview is clamped to three
             lines with the full text in a tooltip. -->
        <Grid Grid.Row="1" Height="340" ClipToBounds="True"
              Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverted}}">
            <Border>
                <Image Source="{Binding BackdropPath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                       Stretch="UniformToFill" Opacity="0.45" VerticalAlignment="Center"/>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.15,1">
                        <GradientStop Color="#33FFFFFF" Offset="0"/>
                        <GradientStop Color="#B8FFFFFF" Offset="0.5"/>
                        <GradientStop Color="#F5FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Color="#59FFFFFF" Offset="0"/>
                        <GradientStop Color="#F2FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid Margin="30,20,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Portrait poster 2:3, lifted off the backdrop -->
                <Grid Width="200" Height="300" VerticalAlignment="Center" Margin="0,0,28,0">
                    <Border Background="#14000000" CornerRadius="{StaticResource Radius.Art}"
                            Margin="0,12,-6,-6" Effect="{StaticResource ShadowElevated}"/>
                    <Border Style="{StaticResource PosterPlaceholder}" CornerRadius="{StaticResource Radius.Art}">
                        <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphHero}"
                                   Foreground="{StaticResource PlaceholderGlyphBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <Border CornerRadius="{StaticResource Radius.Art}" ClipToBounds="True"
                            BorderBrush="{StaticResource BorderHighBrush}" BorderThickness="1">
                        <Image Source="{Binding PosterPath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                               Stretch="UniformToFill"/>
                    </Border>
                </Grid>

                <!-- Title block -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Style="{StaticResource StatusChip}" Background="{StaticResource AccentGradientSoft}"
                                BorderBrush="{StaticResource AccentBorderBrush}">
                            <TextBlock Text="{Binding TypeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <TextBlock Text="{Binding YearDisplay}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ReleaseDateText, StringFormat= · Released {0}}"
                                   Style="{StaticResource SubText}" FontSize="12.5" VerticalAlignment="Center"
                                   Visibility="{Binding ReleaseDateText, Converter={StaticResource NullToVis}}"/>
                    </StackPanel>

                    <!-- Two lines maximum: a long title trims instead of pushing
                         the overview and the hero actions out of the fixed hero. -->
                    <TextBlock Grid.Row="1" Text="{Binding Title}" Style="{StaticResource HeroTitle}"
                               TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Margin="0,8,0,0" MaxWidth="820" MaxHeight="92"
                               ToolTip="{Binding Title}"/>

                    <TextBlock Grid.Row="2" Text="{Binding GenresText}" Foreground="{StaticResource CyanBrush}"
                               FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxWidth="820"/>

                    <TextBlock Grid.Row="3" Text="{Binding Synopsis}" FontSize="13.5" TextWrapping="Wrap"
                               MaxWidth="760" Margin="0,12,0,0" Foreground="{StaticResource BodySoftBrush}"
                               LineHeight="21" MaxHeight="63" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Synopsis}"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource ActionBarButton}"
                                Command="{Binding OpenInExplorerCommand}"
                                ToolTip="Open the folder that holds the local file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.FolderOpen}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                                <TextBlock Text="Open in Explorer" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionBarButton}" Margin="0"
                                Command="{Binding OpenTrailerCommand}"
                                Visibility="{Binding HasTrailer, Converter={StaticResource BoolToVis}}"
                                ToolTip="Open the trailer link in the browser">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Play}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                                <TextBlock Text="Watch Trailer" FontSize="13"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding MetaText}" Style="{StaticResource SubText}" FontSize="12"
                                   VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" MaxWidth="360"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============ the ONLY scrolling region ============ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="{StaticResource PageMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ metadata editor (replaces the sections) ============ -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}"
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Edit metadata" Style="{StaticResource SubPageTitle}"/>
                        <TextBlock Text="Saved edits are remembered: a later TMDb refresh will not overwrite them."
                                   Style="{StaticResource SubText}" Margin="0,6,0,0"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2">
                                <TextBlock Text="Original title" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditOriginalTitle, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Release year" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditYear, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Original language" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditLanguage, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="TMDb id" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditTmdbId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="IMDb id" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditImdbId, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                                <TextBlock Text="Synopsis" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding EditSynopsis, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Trailer link (opens in the browser)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding EditTrailerName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Column="2" Text="{Binding EditTrailerUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <!-- Cast and crew -->
                        <TextBlock Text="Cast &amp; crew" Style="{StaticResource FieldLabel}"/>
                        <!-- No inner ScrollViewer: the page has exactly one
                             scrolling region, so the wheel never fights itself. -->
                        <ItemsControl ItemsSource="{Binding EditCast}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Text="{Binding Character, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                ToolTip="Remove this row"
                                                Command="{Binding DataContext.RemoveCastRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphXs}"
                                                       Foreground="{StaticResource DangerBrush}"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewCastName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <TextBox Grid.Column="1" Text="{Binding NewCastCharacter, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding AddCastRowCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Icon.Add}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Add"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Series episodes -->
                        <StackPanel Visibility="{Binding IsSeries, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Episodes" Style="{StaticResource FieldLabel}"/>
                            <ItemsControl ItemsSource="{Binding EditEpisodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding SeasonNumber}" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding EpisodeNumber}" Margin="0,0,8,0"/>
                                            <TextBox Grid.Column="2" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="34" Height="34"
                                                    ToolTip="Remove this row"
                                                    Command="{Binding DataContext.RemoveEpisodeRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphXs}"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewEpisodeSeason}" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1" Text="{Binding NewEpisodeNumber}" Margin="0,0,8,0"/>
                                <TextBox Grid.Column="2" Text="{Binding NewEpisodeTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Command="{Binding AddEpisodeRowCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{StaticResource Icon.Add}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                        <TextBlock Text="Add"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBlock Text="Episodes that already have files registered are kept even if removed from this list."
                                       Style="{StaticResource CaptionText}" Margin="0,8,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Command="{Binding SaveCommand}" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Icon.Save}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                                    <TextBlock Text="Save"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ================= read-only: cast + seasons + files ================= -->
                <StackPanel Grid.Row="0" Margin="0,0,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInverted}}">
                    <!-- Cast & crew: the same card + header treatment as every
                         other section on this screen. -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12"
                            Visibility="{Binding HasCast, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.People}" Style="{StaticResource GlyphIcon}"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cast &amp; Crew" Style="{StaticResource SectionTitle}" Margin="9,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Cast}" Margin="0,14,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="138" Margin="0,0,14,16"
                                                Background="{StaticResource CardBrush}"
                                                BorderBrush="{StaticResource BorderLowBrush}"
                                                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="12">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.10" Color="#1B1726"/>
                                            </Border.Effect>
                                            <StackPanel>
                                                <Grid Width="112" Height="112" HorizontalAlignment="Center">
                                                    <Border Style="{StaticResource PosterPlaceholder}" CornerRadius="{StaticResource Radius.Art}">
                                                        <TextBlock Text="{StaticResource Icon.Person}" Style="{StaticResource GlyphLarge}"
                                                                   Foreground="{StaticResource PlaceholderGlyphBrush}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="{StaticResource Radius.Art}" ClipToBounds="True" Width="112" Height="112"
                                                            BorderBrush="{StaticResource BorderLowBrush}" BorderThickness="1">
                                                        <Image Source="{Binding ProfilePath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                                                               Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Margin="2,9,2,0" TextTrimming="CharacterEllipsis" TextAlignment="Center"
                                                           ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding RoleDisplay}" Style="{StaticResource CaptionText}"
                                                           TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="2,2,2,2"
                                                           ToolTip="{Binding RoleDisplay}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Seasons & episodes (series only) -->
                    <ItemsControl ItemsSource="{Binding Seasons}"
                                  Visibility="{Binding HasSeasons, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource Icon.Tv}" Style="{StaticResource GlyphIcon}"
                                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding SeasonHeaderText}" Style="{StaticResource SectionTitle}"
                                                           Margin="9,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding AvailabilityText}"
                                                       Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Episodes}" Margin="0,10,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Available episodes get a green-tinted row and a solid
                                                         marker; missing ones stay neutral, so a season can be
                                                         scanned at a glance for what is actually on disk. -->
                                                    <Border x:Name="RowChrome" Background="Transparent"
                                                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                            CornerRadius="{StaticResource Radius.Sm}" Padding="10,7" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="52"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Background="{StaticResource AccentGradientSoft}" CornerRadius="{StaticResource Radius.Xs}"
                                                                    Padding="7,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding EpisodeLabel, Mode=OneWay}" FontSize="11"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" Margin="12,0,0,0" FontWeight="SemiBold"
                                                                       ToolTip="{Binding Title}"/>
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                                <Border x:Name="AvailabilityMark" Width="8" Height="8" VerticalAlignment="Center"
                                                                        CornerRadius="{StaticResource Radius.Xs}" Background="{StaticResource FaintTextBrush}"/>
                                                                <TextBlock x:Name="FileSummaryText" Text="{Binding FileSummary}"
                                                                           Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding HasFile}" Value="True">
                                                            <Setter TargetName="RowChrome" Property="Background" Value="{StaticResource OkSoftBrush}"/>
                                                            <Setter TargetName="RowChrome" Property="BorderBrush" Value="#4D15803D"/>
                                                            <Setter TargetName="AvailabilityMark" Property="Background" Value="{StaticResource OkBrush}"/>
                                                            <Setter TargetName="FileSummaryText" Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Files (movies) -->
                    <Border Style="{StaticResource CardBorder}"
                            Visibility="{Binding HasSeasons, Converter={StaticResource BoolToVisInverted}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Copy}" Style="{StaticResource GlyphIcon}"
                                           Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Local Files" Style="{StaticResource SectionTitle}" Margin="9,0,0,0"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Files}" Margin="0,10,0,0"
                                          Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,5">
                                            <Ellipse Style="{StaticResource AvailabilityDot}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding FileName}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                                       MaxWidth="520" ToolTip="{Binding FilePath}"/>
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" Margin="12,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No media file is registered for this title yet." Style="{StaticResource SubText}" Margin="0,8,0,0"
                                       Visibility="{Binding HasFiles, Converter={StaticResource BoolToVisInverted}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
