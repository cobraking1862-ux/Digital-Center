<UserControl x:Class="DigitalCenter.App.Views.DramaDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="26,18,26,28">
            <!-- ================= Top Action Bar ================= -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Command="{Binding GoBackCommand}" Content="‹ Back to Drama"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding BeginEditCommand}" Content="Edit Metadata" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshTmdbCommand}" Content="Refresh TMDb" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding OpenFolderCommand}" Content="Open Folder" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource DangerButton}" Command="{Binding RemoveFromCatalogCommand}" Content="Remove"/>
                </StackPanel>
            </Grid>

            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="0,0,0,10"
                       Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}"/>

            <!-- ================= Backdrop Hero + Vertical Drama Details ================= -->
            <Border Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True" Margin="0,0,0,16">
                <Grid>
                    <!-- Backdrop Hero -->
                    <Grid Height="260" VerticalAlignment="Top" Visibility="{Binding HasBackdrop, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding BackdropAbsolutePath}" Stretch="UniformToFill" Opacity="0.24"/>
                        <Border>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#10FFFFFF" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <Grid Margin="22">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Poster -->
                        <Border Grid.Column="0" Width="190" Height="275" CornerRadius="8" ClipToBounds="True"
                                VerticalAlignment="Top" Background="{StaticResource PanelBrush}"
                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="30"
                                           Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding PosterAbsolutePath}" Stretch="UniformToFill"
                                       Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- Vertical Focused Drama Details -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>

                            <WrapPanel Margin="0,8,0,10">
                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="0,0,6,4">
                                    <TextBlock Text="{Binding Status}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Background="#E2E8F0" Margin="0,0,6,4"
                                        Visibility="{Binding Year, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding Year}" FontSize="11.5" Foreground="{StaticResource TextBrush}"/>
                                </Border>
                                <Border Style="{StaticResource StatusPill}" Background="#FEF3C7" Margin="0,0,6,4"
                                        Visibility="{Binding RatingText, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <TextBlock Text="{Binding RatingText, StringFormat=★ {0}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                                </Border>
                            </WrapPanel>

                            <TextBlock Text="{Binding Overview}" FontSize="13.5" LineHeight="21" TextWrapping="Wrap" Margin="0,0,0,12"
                                       Visibility="{Binding HasOverview, Converter={StaticResource BoolToVis}}"/>

                            <!-- Vertical metadata table -->
                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="{Binding StatsText}" FontWeight="SemiBold" FontSize="12.5" Margin="0,2"/>
                                <TextBlock Text="{Binding Genres, StringFormat=Genres: {0}}" Style="{StaticResource SubText}" Margin="0,2"
                                           Visibility="{Binding Genres, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding Language, StringFormat=Language: {0}}" Style="{StaticResource SubText}" Margin="0,2"
                                           Visibility="{Binding Language, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding TmdbId, StringFormat=TMDb ID: {0}}" Style="{StaticResource CaptionText}" Margin="0,2"
                                           Visibility="{Binding TmdbId, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding ImdbId, StringFormat=IMDb ID: {0}}" Style="{StaticResource CaptionText}" Margin="0,2"
                                           Visibility="{Binding ImdbId, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"/>
                                <TextBlock Text="{Binding FolderPath, StringFormat=Folder: {0}}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding FolderPath}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Inline Edit Metadata Panel ================= -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Edit Drama Metadata" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Status" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding EditableStatuses}" SelectedItem="{Binding EditStatus, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="TMDb ID (TV)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding EditTmdbId, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Enter the numeric TMDb TV show ID (e.g. 217830) to pin and sync metadata directly"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Overview" Style="{StaticResource FieldLabel}" Margin="0,8,0,0"/>
                    <TextBox Text="{Binding EditOverview, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="64"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Command="{Binding PickPosterCommand}" Content="Change Poster…"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding CancelEditCommand}" Content="Cancel" Margin="0,0,8,0"/>
                            <Button Command="{Binding SaveEditCommand}" Content="Save Changes"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================= Horizontal Cast Row ================= -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16"
                    Visibility="{Binding HasCast, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Cast" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Cast}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="116" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="6" Margin="0,0,10,4">
                                        <StackPanel>
                                            <Border Height="118" CornerRadius="4" ClipToBounds="True" Background="#E2E8F0">
                                                <Image Source="{Binding ProfileAbsolutePath}" Stretch="UniformToFill"
                                                       Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBlock Text="{Binding Character}" Style="{StaticResource CaptionText}" FontSize="10.5"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Character}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ================= Separate Seasons & Checkbox Episode List ================= -->
            <TextBlock Text="Seasons &amp; Episodes" Style="{StaticResource SectionTitle}" FontSize="17" Margin="2,0,0,4"/>
            <TextBlock Text="Tick any episode checkbox to add it directly to the USB Cart → Dramas bucket for copying to Android or USB."
                       Style="{StaticResource SubText}" Margin="2,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Seasons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HeaderText}" Style="{StaticResource SectionTitle}" FontSize="15"/>
                                        <TextBlock Text="{Binding SummaryText}" Style="{StaticResource SubText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                            Content="Toggle All in Season"
                                            Command="{Binding DataContext.ToggleAllInSeasonCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding Episodes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Checkbox directly adds/removes from USB Cart Dramas bucket -->
                                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsInCart, Mode=TwoWay}"
                                                              IsEnabled="{Binding ExistsOnDisk}"
                                                              VerticalAlignment="Center" Margin="0,0,10,0"
                                                              ToolTip="Tick to add this episode to USB Cart → Dramas"/>

                                                    <!-- Real disk availability dot -->
                                                    <Ellipse Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse" BasedOn="{StaticResource AvailabilityDot}">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="ToolTip" Value="Missing on disk"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ExistsOnDisk}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                                        <Setter Property="ToolTip" Value="Available on disk"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>

                                                    <Border Grid.Column="2" Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="54">
                                                        <TextBlock Text="{Binding EpisodeBadge}" FontSize="11" FontWeight="Bold"
                                                                   HorizontalAlignment="Center" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                            <Border Style="{StaticResource StatusPill}" Background="#DCFCE7" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsInCart, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="In USB Cart" FontSize="10" FontWeight="Bold" Foreground="{StaticResource OkBrush}"/>
                                                            </Border>
                                                            <Border Style="{StaticResource StatusPill}" Background="#F1F5F9" Margin="6,0,0,0"
                                                                    Visibility="{Binding HasCopyCount, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding CopyCountText}" FontSize="10" Foreground="{StaticResource SubTextBrush}"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionText}"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource CaptionText}"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="8,3" Content="Locate"
                                                                Command="{Binding DataContext.OpenEpisodeInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
