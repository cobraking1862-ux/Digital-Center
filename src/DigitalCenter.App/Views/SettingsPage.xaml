<UserControl x:Class="DigitalCenter.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DigitalCenter.App.Views"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:IndexToBoolConverter x:Key="IndexIs"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>

        <!-- Toggle row: label + description left, switch right -->
        <DataTemplate x:Key="SwitchRowTemplate">
            <Grid/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header with global actions ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Configuration" Style="{StaticResource EyebrowText}"/>
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}" Margin="0,4,0,0"/>
                <TextBlock Text="Application preferences: library roots, metadata and artwork, file operations, USB copying and naming. The Watch Folder is managed in the Management workspace."
                           Style="{StaticResource SubText}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                        Command="{Binding DiscardChangesCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Refresh}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                        <TextBlock Text="Discard Changes"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Save}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                        <TextBlock Text="Save Settings"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="238"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Category navigation (icon + label) ============ -->
            <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavListBoxItem}" SelectedIndex="0"
                     VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Settings}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="General" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Library}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Cloud}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="Metadata" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Copy}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="File Operations" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Font}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="Naming &amp; Organization" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource Icon.Diagnostic}" Style="{StaticResource GlyphIcon}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" VerticalAlignment="Center"/>
                        <TextBlock Text="Application" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="14,0,0,0">
                <StackPanel>

                    <!-- ===================== General ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=0}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="DigitalCenter stores its database, artwork cache, backups and logs under one data root."
                                           Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <Separator Style="{StaticResource Divider}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding AppVersion}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Database" Style="{StaticResource CaptionText}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding DatabaseLocation}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                        <TextBlock Text="Settings file" Style="{StaticResource CaptionText}" Margin="0,10,0,2"/>
                                        <TextBlock Text="{Binding SettingsLocation}" Style="{StaticResource SubText}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
                                            Command="{Binding OpenDataFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.FolderOpen}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open data folder"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="6,12,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ===================== Library ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=1}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Library roots" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="The movies and series roots are independent folders. Changing them here never moves files."
                                           Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"/>

                                <TextBlock Text="Movies library root" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding MoviesRoot, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding BrowseMoviesRootCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.Folder}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Browse…"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenMoviesRootCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.FolderOpen}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <TextBlock Text="Series library root" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding SeriesRoot, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding BrowseSeriesRootCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.Folder}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Browse…"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                            Command="{Binding OpenSeriesRootCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.FolderOpen}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Open"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="Tip: run a scan of both roots from Settings › Application."
                                           Style="{StaticResource CaptionText}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Metadata ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=2}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="TMDb" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="The read access token comes from configuration only (appsettings.json, the Tmdb__ReadAccessToken environment variable or .NET user secrets). It is never shown here or written to logs."
                                           Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding TestTmdbCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{StaticResource Icon.Cloud}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"/>
                                            <TextBlock Text="Test connection"/>
                                        </StackPanel>
                                    </Button>
                                    <Border Style="{StaticResource StatusChip}" Margin="12,0,0,0" VerticalAlignment="Center"
                                            Background="{StaticResource PrimaryDimBrush}">
                                        <TextBlock Text="{Binding TmdbConfigured, StringFormat=Token configured: {0}}"
                                                   FontSize="11.5" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>

                                <Separator Style="{StaticResource Divider}"/>

                                <TextBlock Text="Artwork preferences" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <CheckBox Content="Download posters" IsChecked="{Binding DownloadPosters}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <CheckBox Content="Download backdrops" IsChecked="{Binding DownloadBackdrops}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <CheckBox Content="Download cast profile images" IsChecked="{Binding DownloadCastProfiles}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <CheckBox Content="Store trailer links" IsChecked="{Binding FetchTrailers}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <TextBlock Text="Manually edited fields are always preserved during TMDb refreshes."
                                           Style="{StaticResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Matching policy stays here (it is a metadata rule);
                             the Watch Folder path and its monitoring live in Management. -->
                        <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Automatic matching" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Minimum match confidence" Style="{StaticResource FieldLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <Slider Minimum="0.30" Maximum="0.95" Value="{Binding MinimumMatchConfidence}"
                                            Width="240" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding MinimumMatchConfidence, StringFormat={}{0:P0}}"
                                               Style="{StaticResource SubText}" Margin="12,0,0,0" VerticalAlignment="Center"
                                               FontWeight="SemiBold" MinWidth="44"/>
                                </StackPanel>
                                <TextBlock Text="Candidates below this score are marked “No Match”; the file stays in place. The Watch Folder itself — its path and the monitoring switches — is managed in the Management workspace."
                                           Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== File Operations ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=3}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="File operations" Style="{StaticResource SectionTitle}"/>
                                <CheckBox Content="Rename imported files to clean names (uses the templates below)"
                                          IsChecked="{Binding CleanFilenames}" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <CheckBox Content="Verify SHA-256 hashes after copying to USB"
                                          IsChecked="{Binding VerifyHashes}" Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <TextBlock Text="When the destination file already exists" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedIndex="{Binding ConflictIndex}"
                                          Width="190" HorizontalAlignment="Left"/>
                                <TextBlock Text="Imports never overwrite silently: every move is previewed and confirmed in Management, and collisions are resolved by the policy above."
                                           Style="{StaticResource CaptionText}" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Naming & Organization ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=4}">
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Naming &amp; organization" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Templates for clean file names. There is no mandatory folder hierarchy — you choose the destination folder for every import."
                                           Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                <TextBlock Text="Movie file-name template ({Title}, {Year})" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding MovieFilenameTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="Series file-name template ({Title}, {Season}, {Episode}, zero-padded {Season:00}/{Episode:00})"
                                           Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding SeriesFilenameTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                                <Separator Style="{StaticResource Divider}"/>
                                <TextBlock Text="USB layout" Style="{StaticResource SectionTitle}" FontSize="14"/>
                                <CheckBox Content="Create a folder for each title on the USB drive" IsChecked="{Binding CreatePerTitleFolders}"
                                          Style="{StaticResource ToggleSwitch}" Margin="0,12,0,0"/>
                                <TextBlock Text="USB subfolder (created on the drive when copying starts)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding UsbCopySubfolder, UpdateSourceTrigger=PropertyChanged}" Width="230"
                                         HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ===================== Application (maintenance) ===================== -->
                    <StackPanel Visibility="{Binding SelectedIndex, ElementName=CategoryList, Converter={StaticResource IndexIs}, ConverterParameter=5}">
                        <views:MaintenancePage DataContext="{Binding Maintenance}"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
