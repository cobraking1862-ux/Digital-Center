<UserControl x:Class="DigitalCenter.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Configure Movie and Drama library folders, Watch Folder locations, TMDb match confidence, and USB copy options."
                           Style="{StaticResource SubText}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Command="{Binding SaveCommand}" Content="Save Settings"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <StackPanel>

                <!-- ===================== Movies Library & Watch Folder ===================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Movies Library &amp; Watch Folder" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Standalone movies are organized into regional language folders (Hollywood, Bollywood, Chinese, South Indian) under the Movies root, while multi-part franchises are placed into collection sub-folders."
                                   Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Movies library root" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding MoviesRoot, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseMoviesRootCommand}" Content="Browse…"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenMoviesRootCommand}" Content="Open"/>
                        </Grid>

                        <TextBlock Text="Movie Collections root (for multi-part movies like Harry Potter)" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CollectionsRoot, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseCollectionsRootCommand}" Content="Browse…"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenCollectionsRootCommand}" Content="Open"/>
                        </Grid>

                        <TextBlock Text="Movies Watch Folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding WatchFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseWatchFolderCommand}" Content="Browse…"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenWatchFolderCommand}" Content="Open"/>
                        </Grid>

                        <CheckBox Content="Monitor Movies Watch Folder automatically"
                                  IsChecked="{Binding WatchFolderEnabled}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>

                        <Separator Style="{StaticResource Divider}"/>

                        <CheckBox Content="Automatically move watched files into language sub-folders (creates language folder if none exists)"
                                  IsChecked="{Binding AutoOrganizeByLanguage}" Style="{StaticResource ToggleSwitch}" Margin="0,4,0,0"/>
                        <CheckBox Content="Require manual confirmation before moving matched files"
                                  IsChecked="{Binding AskForDestination}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                        <CheckBox Content="Rename imported files using clean templates"
                                  IsChecked="{Binding CleanFilenames}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Drama Catalog & Watch Folder ===================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Drama Catalog &amp; Watch Folder" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="Incoming drama subfolders or episodes in the Drama Watch Folder are matched on TMDb and moved into Drama Root under a folder named after each drama."
                                   Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>

                        <TextBlock Text="Drama library root" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DramaRoot, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseDramaRootCommand}" Content="Browse…"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenDramaRootCommand}" Content="Open"/>
                        </Grid>

                        <TextBlock Text="Drama Watch Folder" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DramaWatchFolderPath, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding BrowseDramaWatchFolderCommand}" Content="Browse…"/>
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                                    Command="{Binding OpenDramaWatchFolderCommand}" Content="Open"/>
                        </Grid>

                        <CheckBox Content="Monitor Drama Watch Folder automatically"
                                  IsChecked="{Binding DramaWatchFolderEnabled}" Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>

                        <TextBlock Text="USB / Android destination folder for Dramas" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding DramaCopySubfolder, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </Border>

                <!-- ===================== TMDb & Artwork ===================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Metadata &amp; Artwork (TMDb)" Style="{StaticResource SectionTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding TestTmdbCommand}" Content="Test TMDb Connection"/>
                            <Border Style="{StaticResource StatusPill}" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Background="{StaticResource PrimaryDimBrush}">
                                <TextBlock Text="{Binding TmdbConfigured, StringFormat=Token configured: {0}}"
                                           FontSize="11.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <Separator Style="{StaticResource Divider}"/>

                        <Grid Margin="0,4,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimum automatic match confidence" FontWeight="SemiBold"/>
                                <TextBlock Text="Lower values match more files automatically (default 50%). Higher values require closer title and year matches."
                                           Style="{StaticResource SubText}" Margin="0,2,12,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Border Grid.Column="1" Style="{StaticResource StatusPill}" VerticalAlignment="Center"
                                    Background="{StaticResource PrimaryDimBrush}" Padding="10,4">
                                <TextBlock Text="{Binding MinimumMatchConfidencePercent, StringFormat={}{0}%}"
                                           FontSize="13" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,4,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="30%" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <Slider Grid.Column="1" Minimum="30" Maximum="95" TickFrequency="5" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding MinimumMatchConfidencePercent, Mode=TwoWay}"
                                    AutomationProperties.Name="Minimum match confidence percent"/>
                            <TextBlock Grid.Column="2" Text="95%" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <Separator Style="{StaticResource Divider}"/>

                        <CheckBox Content="Download posters" IsChecked="{Binding DownloadPosters}"
                                  Style="{StaticResource ToggleSwitch}" Margin="0,4,0,0"/>
                        <CheckBox Content="Download backdrops" IsChecked="{Binding DownloadBackdrops}"
                                  Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                        <CheckBox Content="Download cast profile images" IsChecked="{Binding DownloadCastProfiles}"
                                  Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                        <CheckBox Content="Store trailer links" IsChecked="{Binding FetchTrailers}"
                                  Style="{StaticResource ToggleSwitch}" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Naming & Single USB Folder ===================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="File Naming &amp; USB Folder" Style="{StaticResource SectionTitle}"/>
                        <TextBlock Text="When copying movies to a USB drive, all movie files are placed directly into the single USB folder below without creating language sub-folders."
                                   Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="Movie filename template ({Title}, {Year})" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding MovieFilenameTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Single USB destination folder (Movies)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Text="{Binding UsbCopySubfolder, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="When destination file already exists" Style="{StaticResource FieldLabel}"/>
                                <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedIndex="{Binding ConflictIndex}"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Verify SHA-256 hashes after USB copy" IsChecked="{Binding VerifyHashes}"
                                  Style="{StaticResource ToggleSwitch}" Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>

                <!-- ===================== Application Data ===================== -->
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding AppVersion}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DatabaseLocation, StringFormat=Database: {0}}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SettingsLocation, StringFormat=Settings: {0}}" Style="{StaticResource SubText}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                                Command="{Binding OpenDataFolderCommand}" Content="Open Data Folder"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
