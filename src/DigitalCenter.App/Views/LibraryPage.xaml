<UserControl x:Class="DigitalCenter.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DigitalCenter.App.Controls"
             xmlns:vm="clr-namespace:DigitalCenter.ViewModels;assembly=DigitalCenter.ViewModels"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="EmptyToVis" Invert="True"/>
        <conv:EnumEqualsConverter x:Key="EnumToBool"/>
        <conv:PosterPathToImageConverter x:Key="PosterToImage"/>

        <DataTemplate x:Key="YearComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Year: " Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LanguageComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Language: " Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SortComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sort: " Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header: Segmented Tabs + Improved Search Bar ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SegmentedTrack}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="All Movies"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Dashboard, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Movies"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Movies, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Collections"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Collections, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Genres"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Genres, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Improved Search Bar with Accent Icon Badge, Visible Text Input, Placeholder & Clear Button -->
            <Border Grid.Column="2" Width="360" Height="38" VerticalAlignment="Center"
                    CornerRadius="8" Background="#FFFFFF" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
                        <Setter Property="BorderThickness" Value="1.2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            Background="{StaticResource PrimaryDimBrush}"
                            VerticalAlignment="Center" Margin="6,0,2,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource GlyphIcon}" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="LibrarySearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search the library"/>

                        <TextBlock Text="Search movies, collections, actors, or tags…"
                                   Foreground="{StaticResource FaintTextBrush}"
                                   FontSize="13"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=LibrarySearchBox, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                            VerticalAlignment="Center" Margin="2,0,6,0"
                            Click="OnClearSearchClick" ToolTip="Clear search"
                            Visibility="{Binding Text, ElementName=LibrarySearchBox, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphSmall}" FontSize="10.5"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Filter Bar: Year / Language / Sort + Count ============ -->
        <Grid Grid.Row="1" Margin="0,14,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="155" ItemTemplate="{StaticResource YearComboItem}"
                          ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"/>
                <ComboBox Width="185" ItemTemplate="{StaticResource LanguageComboItem}" Margin="10,0,0,0"
                          ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"/>
                <ComboBox Width="185" ItemTemplate="{StaticResource SortComboItem}" Margin="10,0,0,0"
                          ItemsSource="{Binding SortOptionsSource}" SelectedIndex="{Binding SortIndex}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding TotalMatchesText}" Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="16,0,4,0"/>
        </Grid>

        <!-- ============ Unified Catalog View ============ -->
        <Grid Grid.Row="2">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Center"/>
                <TextBlock Text="Loading catalog…" Style="{StaticResource SubText}" Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding LoadError, Converter={StaticResource NullToVis}}">
                <Border Style="{StaticResource EmptyMedallion}">
                    <TextBlock Text="{StaticResource Icon.Error}" Style="{StaticResource GlyphLarge}" FontSize="26"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Could not load the library" FontSize="16" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoadError}" Style="{StaticResource SubText}" Margin="0,6,0,14"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center"/>
                <Button Content="Retry" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <!-- Empty -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource EmptyMedallion}">
                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="26"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="No media titles found" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Add files to your Watch Folder for automatic metadata and language organization, or scan your library in Settings."
                           Style="{StaticResource SubText}" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="480"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Collection / Genre Filter Chips + Virtualized Poster Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Movie Collections Filter Chips (capped to ~3 rows with vertical scroll) -->
                    <ScrollViewer MaxHeight="120" Margin="0,0,0,12" Padding="0,0,4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Visibility="{Binding IsCollectionsTab, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding CollectionChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ChipToggle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Display}"
                                                  Margin="0,0,8,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Genre Filter Chips (capped to ~3 rows with vertical scroll) -->
                    <ScrollViewer MaxHeight="120" Margin="0,0,0,12" Padding="0,0,4,0"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False"
                                  Visibility="{Binding IsGenresTab, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding GenreChips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource ChipToggle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Display}"
                                                  Margin="0,0,8,8"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Standard">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel ItemWidth="204" ItemHeight="376"
                                                                SpacingX="14" SpacingY="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardHost" Style="{StaticResource PosterCard}"
                                        Width="192" Height="364"
                                        Cursor="Hand"
                                        Focusable="True"
                                        MouseLeftButtonUp="OnCardClick"
                                        ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.HelpText="Double-click or press Enter to open details.">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                      CommandParameter="{Binding}"/>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="248"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Poster Artwork -->
                                        <Grid Grid.Row="0">
                                            <Border Style="{StaticResource PosterPlaceholder}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="24"
                                                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Initials}" FontSize="16" FontWeight="Bold"
                                                               Foreground="{StaticResource BodySoftBrush}" HorizontalAlignment="Center"
                                                               Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding PosterPath, Converter={StaticResource PosterToImage}, Mode=OneWay, IsAsync=True}"
                                                       Stretch="UniformToFill" VerticalAlignment="Top"/>
                                            </Border>
                                            <Border Style="{StaticResource TypeBadge}">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextBrush}"/>
                                            </Border>

                                            <!-- Availability Dot -->
                                            <Ellipse Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,10,10,0" Stroke="#FFFFFF" StrokeThickness="1.5"
                                                     ToolTip="{Binding Availability}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource SubTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Available">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Partial">
                                                                <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Missing">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   Margin="4,8,4,0" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"/>

                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,3,4,0">
                                            <TextBlock Text="{Binding YearDisplay}" Style="{StaticResource SubText}" FontSize="11.5"/>
                                            <TextBlock Text="{Binding FileSummary, StringFormat= · {0}}" Style="{StaticResource CaptionText}"
                                                       Margin="4,0,0,0"/>
                                        </StackPanel>

                                        <Button Grid.Row="4" Style="{StaticResource SecondaryButton}" Padding="8,5" Margin="2,6,2,2"
                                                FontSize="11.5" HorizontalAlignment="Stretch"
                                                Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Add this title to the USB cart">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="{StaticResource Icon.Add}" Style="{StaticResource GlyphSmall}" FontSize="11" Margin="0,0,6,0"/>
                                                <TextBlock Text="Add to Cart"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter TargetName="CardHost" Property="Background" Value="{StaticResource PrimaryDimBrush}"/>
                                    </DataTrigger>
                                    <Trigger SourceName="CardHost" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter TargetName="CardHost" Property="Effect" Value="{StaticResource ShadowPanel}"/>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource StatusBarText}"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4"
                   TextTrimming="CharacterEllipsis" MaxWidth="520"/>
    </Grid>
</UserControl>
