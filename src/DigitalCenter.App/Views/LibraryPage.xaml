<UserControl x:Class="DigitalCenter.App.Views.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DigitalCenter.App.Controls"
             xmlns:vm="clr-namespace:DigitalCenter.ViewModels;assembly=DigitalCenter.ViewModels"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:EnumEqualsConverter x:Key="EnumToBool"/>
        <conv:PosterPathToImageConverter x:Key="PosterToImage"/>

        <!-- Filter combos show their context as a quiet prefix -->
        <DataTemplate x:Key="YearComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Year&#160;&#160;&#160;" Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LanguageComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Language&#160;&#160;&#160;" Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="SortComboItem">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Sort&#160;&#160;&#160;" Foreground="{StaticResource FaintTextBrush}"/>
                <TextBlock Text="{Binding}" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="30,22,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header: eyebrow, tabs left, search right ============ -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="0" Grid.Column="0">
                <TextBlock Text="Your collection" Style="{StaticResource EyebrowText}"/>
            </StackPanel>

            <!-- Search: the only control on the right side of the header -->
            <Grid Grid.Row="0" Grid.Column="1" Width="300" VerticalAlignment="Center">
                <TextBox Style="{StaticResource SearchBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Search the library"/>
                <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource GlyphSmall}"
                           Foreground="{StaticResource FaintTextBrush}" Margin="15,0,0,0"
                           HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"/>
                <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0"
                        Click="OnClearSearchClick" ToolTip="Clear search"
                        Visibility="{Binding SearchText, Converter={StaticResource NullToVis}}">
                    <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphXs}"
                               Foreground="{StaticResource SubTextBrush}"/>
                </Button>
            </Grid>

            <!-- Tab pills inside a glass capsule track -->
            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource CapsuleTrack}"
                    VerticalAlignment="Center" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Movies"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Movies, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Series"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Series, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Collections"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Collections, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="LibraryTabs" Content="Genres"
                                 IsChecked="{Binding SelectedTab, Converter={StaticResource EnumToBool}, ConverterParameter=Genres, Mode=TwoWay}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Subbar: year / language / sort + matches ============ -->
        <Grid Grid.Row="1" Margin="2,14,2,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="158" ItemTemplate="{StaticResource YearComboItem}"
                          ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"/>
                <ComboBox Width="188" ItemTemplate="{StaticResource LanguageComboItem}" Margin="10,0,0,0"
                          ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}"/>
                <ComboBox Width="188" ItemTemplate="{StaticResource SortComboItem}" Margin="10,0,0,0"
                          ItemsSource="{Binding SortOptionsSource}" SelectedIndex="{Binding SortIndex}"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding TotalMatchesText}" Style="{StaticResource SubText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="18,0,4,0"/>
        </Grid>

        <!-- ============ Content states ============ -->
        <Grid Grid.Row="2">
            <!-- Loading -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource EmptyMedallion}">
                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}"
                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ProgressBar IsIndeterminate="True" Width="220" HorizontalAlignment="Center" Margin="0,22,0,0"/>
                <TextBlock Text="Loading the library…" Style="{StaticResource SubText}" Margin="0,12,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Error -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding LoadError, Converter={StaticResource NullToVis}}">
                <Border Style="{StaticResource EmptyMedallion}">
                    <TextBlock Text="{StaticResource Icon.Error}" Style="{StaticResource GlyphLarge}"
                               Foreground="{StaticResource DangerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="The library could not be loaded." FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoadError}" Style="{StaticResource SubText}" Margin="0,8,0,16"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"/>
                <Button Content="Try again" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <!-- Empty -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasNoItems, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource EmptyMedallion}">
                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}"
                               Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="Nothing here yet" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,0"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Import files with the Watch Folder (Management) or scan a library root in Settings › Application."
                           Style="{StaticResource SubText}" Margin="0,8,0,0" TextWrapping="Wrap" MaxWidth="520"
                           TextAlignment="Center" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Collections notice -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsCollectionsTab, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource CardBorder}" Padding="32,30" MaxWidth="520">
                    <StackPanel>
                        <Border Style="{StaticResource EmptyMedallion}">
                            <TextBlock Text="{StaticResource Icon.Library}" Style="{StaticResource GlyphLarge}"
                                       Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Collections" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,0"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Franchise grouping is planned for a future release. Browse by genre in the meantime."
                                   Style="{StaticResource SubText}" Margin="0,8,0,0" HorizontalAlignment="Center"
                                   TextWrapping="Wrap" TextAlignment="Center"/>
                        <Button Content="Browse by genre" Style="{StaticResource SecondaryButton}" Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Click="OnBrowseGenresClick"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Poster grid (grid view only, virtualized) -->
            <Grid Visibility="{Binding IsCollectionsTab, Converter={StaticResource BoolToVisInverted}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Genre chips (Genres tab) -->
                <ItemsControl Grid.Row="0" ItemsSource="{Binding GenreChips}" Margin="2,0,0,14"
                              Visibility="{Binding IsGenresTab, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Style="{StaticResource ChipToggle}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Content="{Binding Display}"
                                          Margin="0,0,8,8"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <ItemsControl ItemsSource="{Binding Items}"
                                  ScrollViewer.CanContentScroll="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Standard">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <controls:VirtualizingWrapPanel ItemWidth="210" ItemHeight="396"
                                                                SpacingX="14" SpacingY="16"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- One click selects, two clicks (or Enter/Space on the
                                     focused card) open the details screen. The shared
                                     CardActivation behaviour ignores clicks that start on an
                                     in-card control, so "Add to Cart" never navigates. -->
                                <Border x:Name="CardHost" Style="{StaticResource PosterCard}"
                                        Width="196" Height="380"
                                        Cursor="Hand"
                                        Focusable="True"
                                        ToolTip="{Binding Title}"
                                        AutomationProperties.Name="{Binding Title}"
                                        AutomationProperties.ItemType="Media title"
                                        controls:CardActivation.IsEnabled="True"
                                        controls:CardActivation.SelectCommand="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        controls:CardActivation.OpenCommand="{Binding DataContext.OpenDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="CardLift" Y="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <!-- 2:3 portrait poster -->
                                        <Grid Height="272">
                                            <Border Style="{StaticResource PosterPlaceholder}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}"
                                                               Foreground="#3A3450" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Initials}" FontSize="17" FontWeight="Bold"
                                                               Foreground="#584F78" HorizontalAlignment="Center"
                                                               Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Radius.Art}" ClipToBounds="True">
                                                <Image Source="{Binding PosterPath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                                                       Stretch="UniformToFill" VerticalAlignment="Top"/>
                                            </Border>
                                            <Border Style="{StaticResource TypeBadge}">
                                                <TextBlock Text="{Binding TypeDisplay}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>

                                            <!-- Availability dot -->
                                            <Ellipse Width="9" Height="9" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                     Margin="0,14,14,0" Stroke="#66000000" StrokeThickness="1"
                                                     ToolTip="{Binding Availability}">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{StaticResource SubTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Available">
                                                                <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Partial">
                                                                <Setter Property="Fill" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AvailabilityState}" Value="Missing">
                                                                <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <!-- Hover scrim with the cart quick action -->
                                            <Border x:Name="HoverScrim" CornerRadius="{StaticResource Radius.Art}" Opacity="0" IsHitTestVisible="True">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0.42"/>
                                                        <GradientStop Color="#D9000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Button Style="{StaticResource SecondaryButton}" Padding="12,6"
                                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Margin="9" FontSize="12"
                                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="Add this title to the USB cart">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{StaticResource Icon.Add}" Style="{StaticResource GlyphXs}" Margin="0,0,7,0"/>
                                                        <TextBlock Text="Add to Cart"/>
                                                    </StackPanel>
                                                </Button>
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                                   Margin="5,10,5,0" TextTrimming="CharacterEllipsis" MaxHeight="38"
                                                   TextWrapping="Wrap" ToolTip="{Binding Title}"/>
                                        <StackPanel Orientation="Horizontal" Margin="5,4,5,0">
                                            <TextBlock Text="{Binding YearDisplay}" Style="{StaticResource SubText}" FontWeight="Medium"/>
                                            <TextBlock Text="{Binding FileSummary, StringFormat= · {0}}" Style="{StaticResource CaptionText}"
                                                       Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Genres}" Margin="5,6,5,0" ClipToBounds="True">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GenreChip}" Margin="0,0,5,0">
                                                        <TextBlock Text="{Binding}" Style="{StaticResource MiniChipText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Selection ring: single click only marks the card -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        <Setter TargetName="CardHost" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                                    </DataTrigger>
                                    <Trigger SourceName="CardHost" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                        <Setter TargetName="CardHost" Property="Effect" Value="{StaticResource ShadowElevated}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                                     To="1.03" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                                     To="1.03" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                                     To="-4" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity"
                                                                     To="1" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                                     To="0" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="HoverScrim" Storyboard.TargetProperty="Opacity"
                                                                     To="0" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Transient status -->
        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource StatusBarText}"
                   VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,4,4"
                   TextTrimming="CharacterEllipsis" MaxWidth="560"/>
    </Grid>
</UserControl>
