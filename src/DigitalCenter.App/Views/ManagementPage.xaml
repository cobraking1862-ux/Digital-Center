<UserControl x:Class="DigitalCenter.App.Views.ManagementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolConverter x:Key="InverseBool"/>
        <conv:StatusKeyToBrushConverter x:Key="StatusBrush"/>

        <Style x:Key="RowStatusPill" TargetType="Border">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Watch Folder" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Track Movie and Drama watch folder imports side by side. Configure folder locations in Settings."
                           Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding OpenMaintenanceIssuesCommand}"
                    Visibility="{Binding HasUnresolvedIssues, Converter={StaticResource BoolToVis}}"
                    ToolTip="Open Watch Folder Issues in Maintenance">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource WarnBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding UnresolvedIssuesBadgeText}" FontWeight="SemiBold" Foreground="{StaticResource WarnBrush}"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ============ Separate Status Section (Movies & Dramas — No Awaiting Info) ============ -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Movies Watch Status Card -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Movies Watch Status" FontWeight="SemiBold" FontSize="13.5"/>
                            <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding MovieWatchStateText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding MovieWatchPathSummary}" Style="{StaticResource CaptionText}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MovieWatchPathSummary}"/>
                        <TextBlock Text="{Binding MovieLastScanText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Imported" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding MovieImportedCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource OkBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Drama Watch Status Card -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Drama Watch Status" FontWeight="SemiBold" FontSize="13.5"/>
                            <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding DramaWatchStateText}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryDarkBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding DramaWatchPathSummary}" Style="{StaticResource CaptionText}"
                                   Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DramaWatchPathSummary}"/>
                        <TextBlock Text="{Binding DramaLastScanText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="Imported" Style="{StaticResource CaptionText}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding DramaImportedCount}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource OkBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Busy / Feedback Strip ============ -->
        <StackPanel Grid.Row="2" Margin="0,10,0,4">
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="2,4,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- ============ Two-Panel Import Logs (Movies | Dramas) ============ -->
        <Grid Grid.Row="3" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Movie Imports -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Movie Panel Header + Movie Buttons Above Movie Imports -->
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Movie Imports" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Margin="0,0,8,0" Padding="12,5"
                                        Command="{Binding ScanMoviesCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Content="Scan Movies"/>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5"
                                        Command="{Binding OpenMoviesWatchFolderCommand}"
                                        Content="Open Movies"/>
                                <Button Style="{StaticResource DangerButton}" Padding="10,5"
                                        Command="{Binding ClearMovieHistoryCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Content="Clear Movie History"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Movie Imports List -->
                    <Grid Grid.Row="1">
                        <TextBlock Text="No movie imports logged yet. Drop movie files in your Movies Watch Folder or click Scan Movies."
                                   Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                   Visibility="{Binding HasNoMovieActivity, Converter={StaticResource BoolToVis}}"/>

                        <ListBox ItemsSource="{Binding Activity}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="Transparent" Padding="14,10" BorderThickness="0,0,0,1"
                                                        BorderBrush="{StaticResource DividerBrush}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourcePath}"/>
                                            <TextBlock Text="{Binding MatchSummary}" Style="{StaticResource SubText}" FontSize="11.5"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding MatchSummary}"/>
                                            <TextBlock Text="{Binding TimestampText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource RowStatusPill}">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{Binding StatusKey, Converter={StaticResource StatusBrush}}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Drama Imports -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drama Panel Header + Drama Buttons Above Drama Imports -->
                    <Border Grid.Row="0" Padding="14,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Drama Imports" Style="{StaticResource SectionTitle}"/>
                            <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                                <Button Margin="0,0,8,0" Padding="12,5"
                                        Command="{Binding ScanDramasCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Content="Scan Dramas"/>
                                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,5"
                                        Command="{Binding OpenDramaWatchFolderCommand}"
                                        Content="Open Drama"/>
                                <Button Style="{StaticResource DangerButton}" Padding="10,5"
                                        Command="{Binding ClearDramaHistoryCommand}"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                        Content="Clear Drama History"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Drama Imports List -->
                    <Grid Grid.Row="1">
                        <TextBlock Text="No drama imports logged yet. Drop drama subfolders or episodes in your Drama Watch Folder or click Scan Dramas."
                                   Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="24"
                                   Visibility="{Binding HasNoDramaActivity, Converter={StaticResource BoolToVis}}"/>

                        <ListBox ItemsSource="{Binding DramaActivity}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Chrome" Background="Transparent" Padding="14,10" BorderThickness="0,0,0,1"
                                                        BorderBrush="{StaticResource DividerBrush}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DramaTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding EpisodeBadge}" FontSize="10.5" FontWeight="Bold"
                                                               Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SourceFileName}" Style="{StaticResource SubText}" FontSize="11.5"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}"/>
                                            <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0">
                                                <Run Text="{Binding TimestampText, Mode=OneWay}"/>
                                                <Run Text=" · "/>
                                                <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource RowStatusPill}" Background="#DCFCE7" BorderBrush="#86EFAC">
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource OkBrush}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
