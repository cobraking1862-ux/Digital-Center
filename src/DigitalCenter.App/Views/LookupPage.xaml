<UserControl x:Class="DigitalCenter.App.Views.LookupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="EmptyToVis" Invert="True"/>
    </UserControl.Resources>

    <Grid Margin="24,18,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================== Header ======================== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Lookup" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Search IMDb to resolve a movie's IMDb ID, run background availability checks across your enabled sites (managed in Maintenance → Lookup Sites), launch one-click workflow downloads to IDM, or file tickets."
                       Style="{StaticResource SubText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ======================== Main 2-Column Layout ======================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="460"/>
            </Grid.ColumnDefinitions>

            <!-- ============ LEFT: Movies-Style Search Bar + IMDb Matches ============ -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="1. Select IMDb Match" Style="{StaticResource SectionTitle}" Margin="0,0,0,10"/>

                    <!-- Left-aligned Movies-Style Search Bar -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Height="38" VerticalAlignment="Center"
                                CornerRadius="8" Background="#FFFFFF" SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
                                    <Setter Property="BorderThickness" Value="1.2"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="BorderThickness" Value="1.6"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                                        Background="{StaticResource PrimaryDimBrush}"
                                        VerticalAlignment="Center" Margin="6,0,2,0"
                                        IsHitTestVisible="False">
                                    <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource GlyphIcon}" FontSize="13"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <Grid Grid.Column="1">
                                    <TextBox x:Name="LookupSearchBox"
                                             Style="{StaticResource SearchBox}"
                                             Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Search IMDb">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding SearchImdbCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>

                                    <TextBlock Text="Type a title or paste IMDb ID (e.g. tt1272878)…"
                                               Foreground="{StaticResource FaintTextBrush}"
                                               FontSize="13"
                                               Margin="8,0,4,0"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=LookupSearchBox, Converter={StaticResource EmptyToVis}}"/>
                                </Grid>

                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                                        VerticalAlignment="Center" Margin="2,0,6,0"
                                        Click="OnClearSearchClick" ToolTip="Clear search"
                                        Visibility="{Binding Text, ElementName=LookupSearchBox, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphSmall}" FontSize="10.5"
                                               Foreground="{StaticResource SubTextBrush}"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Button Grid.Column="2" Command="{Binding SearchImdbCommand}" Content="Search IMDb" Height="38" Padding="16,0"/>
                    </Grid>

                    <StackPanel Grid.Row="2" Margin="0,0,0,8">
                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,4"
                                     Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>

                    <ListBox Grid.Row="3" ItemsSource="{Binding Results}"
                             SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="46" Height="66" CornerRadius="4"
                                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1" Margin="0,0,12,0"
                                                Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Margin="0,3,0,2">
                                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding ImdbId}" FontSize="11" FontWeight="Bold"
                                                               FontFamily="Consolas" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#E2E8F0" Margin="0,0,6,2">
                                                    <TextBlock Text="{Binding MediaType}" FontSize="11" Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#DCFCE7" Margin="0,0,6,2"
                                                        Visibility="{Binding InLocalLibrary, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="In Local Library" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource OkBrush}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding YearText}" Style="{StaticResource CaptionText}"
                                                       Visibility="{Binding YearText, Converter={StaticResource BoolToVis}, FallbackValue=Visible}"/>
                                            <TextBlock Text="{Binding CastSummary}" Style="{StaticResource CaptionText}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasCast, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <Button Grid.Column="2" Style="{StaticResource SecondaryButton}"
                                                Content="View in Library" VerticalAlignment="Center" Padding="10,4"
                                                Visibility="{Binding InLocalLibrary, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.OpenInLocalLibraryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3"
                               Text="Search for a movie above to resolve its IMDb ID."
                               Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>

            <!-- ============ RIGHT: Background Availability Output + One-Click Download ============ -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="2. Site Availability" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>

                    <!-- Selected Match + Check Availability & File Ticket CTAs -->
                    <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedSummaryText}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding CheckAvailabilityCommand}" Content="Check Availability"/>
                                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Command="{Binding FileTicketCommand}" Content="File Ticket"/>
                                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCheckCommand}" Content="Cancel"/>
                            </Grid>
                            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0"
                                         Visibility="{Binding IsCheckingAvailability, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>

                    <!-- Summary bar -->
                    <TextBlock Grid.Row="2" Text="{Binding CheckSummaryText}" Style="{StaticResource StatusBarText}"
                               Margin="0,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding HasCheckSummary, Converter={StaticResource BoolToVis}}"/>

                    <!-- Per-Site Status Output List -->
                    <ListBox Grid.Row="3" ItemsSource="{Binding AvailabilityChecks}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SiteName}" FontWeight="SemiBold" FontSize="13"/>

                                                <Border Style="{StaticResource StatusPill}" Background="#DCFCE7" Margin="8,0,0,0"
                                                        Visibility="{Binding IsResults, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Results" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource OkBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#F1F5F9" Margin="8,0,0,0"
                                                        Visibility="{Binding IsNoResults, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="No Results" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#FEF3C7" Margin="8,0,0,0"
                                                        Visibility="{Binding IsBlocked, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Blocked" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#FEE2E2" Margin="8,0,0,0"
                                                        Visibility="{Binding IsError, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Error" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="8,0,0,0"
                                                        Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Checking…" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding DetailWithTiming}" Style="{StaticResource CaptionText}"
                                                       Margin="0,3,0,0" TextWrapping="Wrap"/>

                                            <!-- Inline Workflow Download Status / Browser-Required Hint -->
                                            <TextBlock Text="{Binding DownloadStatusText}" FontSize="11.5" FontWeight="SemiBold"
                                                       Margin="0,4,0,0" TextWrapping="Wrap"
                                                       Visibility="{Binding HasDownloadStatus, Converter={StaticResource BoolToVis}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsBrowserAttention}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource WarnBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding DownloadButtonLabel}" Padding="10,5" Margin="0,0,6,0"
                                                    Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.DownloadFromSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Resolve best quality using Settings default and open IDM confirmation dialog"/>

                                            <Button Content="{Binding OpenButtonLabel}" Padding="10,5"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding DataContext.OpenCheckedSiteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsBrowserAttention}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="3"
                               Text="No Lookup sites are enabled. Go to Maintenance → Lookup Sites to add or tick sites."
                               Style="{StaticResource SubText}" TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" TextAlignment="Center" Margin="14"
                               Visibility="{Binding HasNoEnabledSites, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
