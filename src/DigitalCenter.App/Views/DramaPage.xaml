<UserControl x:Class="DigitalCenter.App.Views.DramaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="EmptyToVis" Invert="True"/>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Header: Inline Status Labels Row + Movies-Style Search Bar ============ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SegmentedTrack}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="DramaStatusTabs" Content="All"
                                 IsChecked="{Binding IsAllStatus, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="DramaStatusTabs" Content="Ongoing"
                                 IsChecked="{Binding IsOngoingStatus, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="DramaStatusTabs" Content="Completed"
                                 IsChecked="{Binding IsCompletedStatus, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="DramaStatusTabs" Content="On Hold"
                                 IsChecked="{Binding IsOnHoldStatus, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Movies-Style Search Bar -->
            <Border Grid.Column="2" Width="360" Height="38" VerticalAlignment="Center"
                    CornerRadius="8" Background="#FFFFFF" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
                        <Setter Property="BorderThickness" Value="1.2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            Background="{StaticResource PrimaryDimBrush}"
                            VerticalAlignment="Center" Margin="6,0,2,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource GlyphIcon}" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="DramaSearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search dramas"/>

                        <TextBlock Text="Search dramas, channels, or genres…"
                                   Foreground="{StaticResource FaintTextBrush}"
                                   FontSize="13"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=DramaSearchBox, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                            VerticalAlignment="Center" Margin="2,0,6,0"
                            Click="OnClearSearchClick" ToolTip="Clear search"
                            Visibility="{Binding Text, ElementName=DramaSearchBox, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphSmall}" FontSize="10.5"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Count Strip ============ -->
        <Grid Grid.Row="1" Margin="0,12,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Open any drama to view separate seasons and tick episodes for USB Cart."
                       Style="{StaticResource SubText}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding TotalMatchesText}" Style="{StaticResource SubText}"
                       VerticalAlignment="Center" Margin="14,0,4,0"/>
        </Grid>

        <!-- ============ Activity Bar ============ -->
        <StackPanel Grid.Row="2" Margin="0,0,0,8">
            <ProgressBar IsIndeterminate="True" Height="4"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="0,4,0,0"
                       Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>

        <!-- ============ Poster Grid ============ -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <ItemsControl ItemsSource="{Binding Dramas}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PosterCard}" Width="188" Margin="0,0,14,14"
                                    Cursor="Hand" MouseLeftButtonUp="OnDramaCardClick" ToolTip="{Binding Title}">
                                <StackPanel>
                                    <Grid Height="252">
                                        <Border Style="{StaticResource PosterPlaceholder}">
                                            <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="24"
                                                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Border CornerRadius="6" ClipToBounds="True"
                                                Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding PosterAbsolutePath}" Stretch="UniformToFill" VerticalAlignment="Top"/>
                                        </Border>

                                        <!-- Status / Season Pill (top-left) -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8"
                                                Background="#CCFFFFFF" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding SeasonBadgeText}" FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"/>
                                        </Border>

                                        <!-- Real Disk Availability Dot (top-right) -->
                                        <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse" BasedOn="{StaticResource AvailabilityDot}">
                                                    <Setter Property="Fill" Value="{StaticResource DangerBrush}"/>
                                                    <Setter Property="ToolTip" Value="One or more episodes missing on disk"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AllOnDisk}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource OkBrush}"/>
                                                            <Setter Property="ToolTip" Value="All episodes available on disk"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                    </Grid>

                                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                               Margin="4,8,4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding SubtitleText}" Style="{StaticResource CaptionText}"
                                               Margin="4,2,4,4" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,80,0,0"
                            Visibility="{Binding HasNoDramas, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="No dramas in your catalog yet" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Configure your Drama Root in Settings and run Scan Drama Folder in Maintenance, or drop episodes into your Drama Watch Folder."
                               Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
