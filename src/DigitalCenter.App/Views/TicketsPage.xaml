<UserControl x:Class="DigitalCenter.App.Views.TicketsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:NullToVisibilityConverter x:Key="EmptyToVis" Invert="True"/>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================== Header ======================== -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Tickets" Style="{StaticResource PageTitle}"/>
                <TextBlock Text="Track movies filed from Lookup with their creation date and availability results, open matching sites anytime, and mark tickets Completed when done."
                           Style="{StaticResource SubText}" Margin="0,3,16,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Content="Refresh" Margin="0,0,8,0"/>
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding ClearCompletedCommand}" Content="Clear Completed"/>
            </StackPanel>
        </Grid>

        <!-- ======================== Inline Status Labels Row + Movies-Style Search Bar ======================== -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SegmentedTrack}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="TicketStatusTabs" Content="Open"
                                 IsChecked="{Binding IsOpenFilter, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="TicketStatusTabs" Content="Completed"
                                 IsChecked="{Binding IsCompletedFilter, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TopNavRadio}" GroupName="TicketStatusTabs" Content="All"
                                 IsChecked="{Binding IsAllFilter, Mode=TwoWay}"/>
                </StackPanel>
            </Border>

            <!-- Movies-Style Search Bar -->
            <Border Grid.Column="2" Width="360" Height="38" VerticalAlignment="Center"
                    CornerRadius="8" Background="#FFFFFF" SnapsToDevicePixels="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
                        <Setter Property="BorderThickness" Value="1.2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="BorderThickness" Value="1.6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6"
                            Background="{StaticResource PrimaryDimBrush}"
                            VerticalAlignment="Center" Margin="6,0,2,0"
                            IsHitTestVisible="False">
                        <TextBlock Text="{StaticResource Icon.Search}" Style="{StaticResource GlyphIcon}" FontSize="13"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <Grid Grid.Column="1">
                        <TextBox x:Name="TicketsSearchBox"
                                 Style="{StaticResource SearchBox}"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search tickets"/>

                        <TextBlock Text="Search tickets by title or IMDb ID…"
                                   Foreground="{StaticResource FaintTextBrush}"
                                   FontSize="13"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=TicketsSearchBox, Converter={StaticResource EmptyToVis}}"/>
                    </Grid>

                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="26" Height="26"
                            VerticalAlignment="Center" Margin="2,0,6,0"
                            Click="OnClearSearchClick" ToolTip="Clear search"
                            Visibility="{Binding Text, ElementName=TicketsSearchBox, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{StaticResource Icon.Clear}" Style="{StaticResource GlyphSmall}" FontSize="10.5"
                                   Foreground="{StaticResource SubTextBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="2,0,0,10"
                   Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}"/>

        <!-- ======================== Ticket Tiles ======================== -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <ItemsControl ItemsSource="{Binding Tickets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Width="380" Margin="0,0,12,12" Padding="14">
                                <StackPanel>
                                    <!-- Top Row: Poster + Title + Ticket # + Status -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="48" Height="68" CornerRadius="4"
                                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="1" Margin="0,0,12,0"
                                                Visibility="{Binding HasPoster, Converter={StaticResource BoolToVis}}">
                                            <Image Source="{Binding PosterUrl}" Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding TitleWithYear}" FontWeight="Bold" FontSize="14.5" TextWrapping="Wrap"/>
                                            <WrapPanel Margin="0,4,0,2">
                                                <Border Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}" Margin="0,0,5,2">
                                                    <TextBlock Text="{Binding TicketNumber}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource StatusPill}" Background="#E2E8F0" Margin="0,0,5,2">
                                                    <TextBlock Text="{Binding ImdbId}" FontSize="10.5" FontFamily="Consolas" Foreground="{StaticResource TextBrush}"/>
                                                </Border>
                                            </WrapPanel>
                                            <TextBlock Text="{Binding CreatedAtText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding CompletedAtText}" Style="{StaticResource CaptionText}"
                                                       Visibility="{Binding HasCompletedAt, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>

                                        <!-- Status Pill -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <Border Style="{StaticResource StatusPill}" Background="#DBEAFE"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Open" FontSize="11" FontWeight="Bold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}" Background="#DCFCE7"
                                                    Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Completed" FontSize="11" FontWeight="Bold" Foreground="{StaticResource OkBrush}"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Availability Result Summary -->
                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="5" Padding="9,7" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Availability Result" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubTextBrush}"/>
                                            <TextBlock Text="{Binding AvailabilitySummary}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>

                                            <ItemsControl ItemsSource="{Binding SiteResults}" Margin="0,6,0,0"
                                                          Visibility="{Binding HasSiteResults, Converter={StaticResource BoolToVis}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding SiteName}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Status}" FontSize="11" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="6,0,8,0"/>
                                                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open" Padding="8,2" FontSize="11"
                                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}"
                                                                    Command="{Binding DataContext.OpenSiteResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Actions -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Command="{Binding DataContext.MarkCompletedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Mark Completed" Padding="12,5" Margin="0,0,6,0"
                                                Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.ReopenTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Reopen" Padding="10,5" Margin="0,0,6,0"
                                                Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}"/>
                                        <Button Style="{StaticResource SecondaryButton}"
                                                Command="{Binding DataContext.DeleteTicketCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Delete" Padding="10,5"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="No tickets found. Search a movie in Lookup and click 'File Ticket' to create one."
                           Style="{StaticResource SubText}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="20,60,20,20"
                           Visibility="{Binding HasNoTickets, Converter={StaticResource BoolToVis}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
