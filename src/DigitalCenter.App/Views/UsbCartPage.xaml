<UserControl x:Class="DigitalCenter.App.Views.UsbCartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:PosterPathToImageConverter x:Key="PosterToImage"/>

        <DataTemplate x:Key="DriveOptionTemplate">
            <StackPanel Margin="2,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding TargetLabel}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DriveTypeDisplay, StringFormat= · {0}}" Style="{StaticResource SubText}"
                               Margin="6,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Left: Dual-Bucket Copy Queue (Movies + Dramas) ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="USB Copy Queue" Style="{StaticResource PageTitle}"/>
                        <Border Background="{StaticResource PrimaryDimBrush}"
                                BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                                CornerRadius="5" Padding="9,2.5" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CartCount, StringFormat={}{0} item(s)}" FontSize="11.5"
                                       FontWeight="SemiBold" Foreground="{StaticResource PrimaryDarkBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Movies copy into your USB folder; Drama episodes copy organized inside per-drama folders on USB or Android."
                               Style="{StaticResource SubText}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource DangerButton}" Command="{Binding ClearCartCommand}" Content="Clear All"/>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Margin="0,12,0,0">
                <!-- ================= Bucket 1: Movies ================= -->
                <TabItem Header="{Binding MoviesBucketHeader}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,70,0,0"
                                        Visibility="{Binding HasMovieItems, Converter={StaticResource BoolToVisInverted}}">
                                <Border Style="{StaticResource EmptyMedallion}">
                                    <TextBlock Text="{StaticResource Icon.Cart}" Style="{StaticResource GlyphLarge}" FontSize="26"
                                               Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Movies bucket is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                <TextBlock Text="Add movies from Library using 'Add to Cart'."
                                           Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding CartItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="CardHost" Style="{StaticResource PosterCard}" Width="180" Margin="0,0,14,14"
                                                MouseDown="OnCardMouseDown" Cursor="Hand" ToolTip="{Binding TitleDisplay}">
                                            <StackPanel>
                                                <Grid Height="236">
                                                    <Border Style="{StaticResource PosterPlaceholder}">
                                                        <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="22"
                                                                   Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border CornerRadius="6" ClipToBounds="True">
                                                        <Image Source="{Binding PosterPath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                                                               Stretch="UniformToFill" VerticalAlignment="Top"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Text="{Binding TitleDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                                           Margin="4,8,4,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding TitleDisplay}"/>
                                                <StackPanel Orientation="Horizontal" Margin="4,3,4,0">
                                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" FontSize="11.5" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding FilesText, StringFormat= · {0}}" Style="{StaticResource CaptionText}"/>
                                                </StackPanel>
                                                <Button Style="{StaticResource SecondaryButton}" FontSize="11.5"
                                                        Margin="2,8,2,2" HorizontalAlignment="Stretch" Padding="8,4"
                                                        Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Remove"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ================= Bucket 2: Dramas ================= -->
                <TabItem Header="{Binding DramasBucketHeader}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,10" Visibility="{Binding HasDramaItems, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Checked drama episodes copy into separate folders named after each drama."
                                       Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Padding="10,4"
                                    Command="{Binding ClearDramaBucketCommand}" Content="Clear Dramas"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,70,0,0"
                                            Visibility="{Binding HasDramaItems, Converter={StaticResource BoolToVisInverted}}">
                                    <Border Style="{StaticResource EmptyMedallion}">
                                        <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphLarge}" FontSize="26"
                                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Dramas bucket is empty" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                                    <TextBlock Text="Open any drama in the Drama section and tick the episodes you want to copy."
                                               Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding DramaCartItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFFFFF" BorderBrush="{StaticResource DividerBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Style="{StaticResource StatusPill}" Background="{StaticResource PrimaryDimBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource PrimaryDarkBrush}"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                        <TextBlock FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding DramaTitle, Mode=OneWay}"/>
                                                            <Run Text=" — " Foreground="{StaticResource SubTextBrush}"/>
                                                            <Run Text="{Binding Title, Mode=OneWay}"/>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding FileName}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <Button Style="{StaticResource SecondaryButton}" Padding="10,4" Content="Remove"
                                                                Command="{Binding DataContext.RemoveDramaEpisodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- ================= Right Rail: Drive, Options & Copy ================= -->
        <Grid Grid.Column="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Destination Drive / Android" Style="{StaticResource SectionTitle}"/>
                            <ComboBox ItemsSource="{Binding Drives}"
                                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DriveOptionTemplate}"
                                      Margin="0,10,0,0" HorizontalAlignment="Stretch"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Include fixed drives"
                                          IsChecked="{Binding IncludeFixedDrives}"
                                          FontSize="11.5" Foreground="{StaticResource SubTextBrush}"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Refresh drives"
                                        Command="{Binding ReloadDrivesCommand}">
                                    <TextBlock Text="{StaticResource Icon.Refresh}" Style="{StaticResource GlyphSmall}"
                                               Foreground="{StaticResource TextBrush}"/>
                                </Button>
                            </Grid>
                            <ProgressBar Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" Maximum="100" Minimum="0"
                                         Height="6" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding SelectedDrive.CapacityText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                            <TextBlock Text="{Binding SpaceEstimateText}" Style="{StaticResource SubText}" FontWeight="SemiBold"
                                       Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding EstimatedTimeText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0"
                                       Visibility="{Binding EstimatedTimeText, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Copy Options" Style="{StaticResource SectionTitle}"/>
                            <CheckBox Content="Clean file names" IsChecked="{Binding CleanFilenames}" Margin="0,10,0,0"/>
                            <CheckBox Content="Verify SHA-256 after copying (Movies)" IsChecked="{Binding VerifyHashes}" Margin="0,8,0,0"/>
                            <TextBlock Text="If file already exists on destination" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedIndex="{Binding ConflictIndex}" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,12,0,0">
                        <StackPanel>
                            <Button Command="{Binding StartCopyCommand}" HorizontalAlignment="Stretch" Content="Start Copy to Device"/>
                            <Button Content="Cancel Copy" Style="{StaticResource DangerButton}" Margin="0,8,0,0"
                                    HorizontalAlignment="Stretch" Command="{Binding CancelCopyCommand}"/>

                            <StackPanel Margin="0,12,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Copying…" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OverallPercent, StringFormat={}{0:0}%}"
                                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Minimum="0" Height="6" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <Border Background="{StaticResource PrimaryDimBrush}" CornerRadius="5" Padding="10,8" Margin="0,10,0,0"
                                    Visibility="{Binding ResultSummaryText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ResultSummaryText}" TextWrapping="Wrap" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="2,8,0,0"
                                       TextWrapping="Wrap" Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
