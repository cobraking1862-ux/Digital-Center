<UserControl x:Class="DigitalCenter.App.Views.UsbCartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:DigitalCenter.App.Converters">

    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisInverted" Invert="True"/>
        <conv:NullToVisibilityConverter x:Key="NullToVis"/>
        <conv:PosterPathToImageConverter x:Key="PosterToImage"/>

        <!-- Drive rows: root, name, type and a mini capacity bar -->
        <DataTemplate x:Key="DriveOptionTemplate">
            <StackPanel Margin="2,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Root}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding DriveTypeDisplay, StringFormat= · {0}}" Style="{StaticResource SubText}"
                               Margin="7,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="26,20,26,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="352"/>
        </Grid.ColumnDefinitions>

        <!-- ================= Cart cards ================= -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Border Style="{StaticResource IconTile}">
                        <TextBlock Text="{StaticResource Icon.Cart}" Style="{StaticResource GlyphMedium}"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="USB Cart" Style="{StaticResource PageTitle}"/>
                            <Border Background="{StaticResource PrimaryDimBrush}"
                                    BorderBrush="{StaticResource AccentBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Pill}" Padding="10,3" Margin="12,4,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CartCount, StringFormat={}{0} item(s)}" FontSize="11"
                                           FontWeight="SemiBold" Foreground="{StaticResource BodySoftBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Titles queued for copying to a removable drive. Sizes come from the real files on disk."
                                   Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Content="Remove Selected" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding RemoveItemCommand}" CommandParameter="{Binding SelectedItem}"/>
                    <Button Style="{StaticResource DangerButton}"
                            Command="{Binding ClearCartCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{StaticResource Icon.Delete}" Style="{StaticResource GlyphXs}" Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="Clear Cart"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Cards -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Margin="0,16,0,0">
                <StackPanel>
                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,90,0,0"
                                Visibility="{Binding HasItems, Converter={StaticResource BoolToVisInverted}}">
                        <Border Style="{StaticResource EmptyMedallion}">
                            <TextBlock Text="{StaticResource Icon.Cart}" Style="{StaticResource GlyphLarge}"
                                       Foreground="{StaticResource SubTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="The cart is empty" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                        <TextBlock Text="Add titles from Home with the “Add to Cart” button on a poster card."
                                   Style="{StaticResource SubText}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CartItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardHost" Style="{StaticResource PosterCard}" Width="184" Margin="0,0,14,14"
                                        MouseDown="OnCardMouseDown" Cursor="Hand"
                                        ToolTip="{Binding TitleDisplay}">
                                    <Border.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform x:Name="CardLift" Y="0"/>
                                        </TransformGroup>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Height="248">
                                            <Border Style="{StaticResource PosterPlaceholder}">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <TextBlock Text="{StaticResource Icon.Film}" Style="{StaticResource GlyphMedium}"
                                                               Foreground="#3A3450" HorizontalAlignment="Center"/>
                                                    <TextBlock Text="No artwork" Style="{StaticResource SubText}" FontSize="10"
                                                               HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border CornerRadius="{StaticResource Radius.Art}" ClipToBounds="True">
                                                <Image Source="{Binding PosterPath, Converter={StaticResource PosterToImage}, Mode=OneWay}"
                                                       Stretch="UniformToFill" VerticalAlignment="Top"/>
                                            </Border>

                                            <!-- Selection check badge -->
                                            <Border x:Name="SelectedBadge" Width="24" Height="24" CornerRadius="{StaticResource Radius.Control}"
                                                    Background="{StaticResource AccentGradient}" Opacity="0"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="9"
                                                    Effect="{StaticResource ShadowAccent}">
                                                <TextBlock Text="{StaticResource Icon.Check}" Style="{StaticResource GlyphXs}"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Bottom scrim: size + files -->
                                            <Border CornerRadius="{StaticResource Radius.ArtBottom}" VerticalAlignment="Bottom">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#B2000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <StackPanel Orientation="Horizontal" Margin="10,18,10,8">
                                                    <TextBlock Text="{StaticResource Icon.Copy}" Style="{StaticResource GlyphXs}"
                                                               Foreground="#D9D4E8"/>
                                                    <TextBlock Text="{Binding SizeText}" FontSize="11.5" FontWeight="SemiBold"
                                                               Foreground="White" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FilesText, StringFormat= · {0}}" FontSize="10.5"
                                                               Foreground="#B4ADCB" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding TitleDisplay}" FontSize="12.5" FontWeight="SemiBold"
                                                   Margin="8,9,8,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                                   MaxHeight="36" ToolTip="{Binding TitleDisplay}"/>
                                        <Button Style="{StaticResource GhostButton}" FontSize="11.5"
                                                Margin="6,5,6,7" HorizontalAlignment="Left" Padding="10,4"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{StaticResource Icon.Remove}" Style="{StaticResource GlyphXs}" Margin="0,0,7,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                <TextBlock Text="Remove"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- Selection ring + badge (drives "Remove Selected") -->
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                        <Setter TargetName="SelectedBadge" Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                    <Trigger SourceName="CardHost" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CardHost" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                                     To="1.02" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                                     To="-3" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY"
                                                                     To="1" Duration="0:0:0.12"/>
                                                    <DoubleAnimation Storyboard.TargetName="CardLift" Storyboard.TargetProperty="Y"
                                                                     To="0" Duration="0:0:0.12"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ================= Right rail: drive, summary, options, run ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- USB drive -->
                    <Border Style="{StaticResource CardBorder}" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.HardDrive}" Style="{StaticResource GlyphIcon}"
                                           Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="USB Drive" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding Drives}"
                                      SelectedItem="{Binding SelectedDrive, Mode=TwoWay}"
                                      ItemTemplate="{StaticResource DriveOptionTemplate}"
                                      Margin="0,12,0,0" HorizontalAlignment="Stretch"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Content="Include fixed drives (for testing)"
                                          IsChecked="{Binding IncludeFixedDrives}"
                                          FontSize="11" Foreground="{StaticResource SubTextBrush}"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="Refresh drives"
                                        Command="{Binding ReloadDrivesCommand}">
                                    <TextBlock Text="{StaticResource Icon.Refresh}" Style="{StaticResource GlyphSmall}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                </Button>
                            </Grid>
                            <ProgressBar Value="{Binding SelectedDrive.UsedPercent, Mode=OneWay}" Maximum="100" Minimum="0"
                                         Height="5" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding SelectedDrive.CapacityText}" Style="{StaticResource CaptionText}"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Cart summary -->
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Diagnostic}" Style="{StaticResource GlyphIcon}"
                                           Foreground="{StaticResource CyanBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Cart Summary" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Total titles" Style="{StaticResource SubText}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding CartCount}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Grid.Row="1" Text="Estimated time" Style="{StaticResource SubText}" Margin="0,9,0,0"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding EstimatedTimeText, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EstimatedTimeText}" FontWeight="SemiBold"
                                           Margin="0,9,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding EstimatedTimeText, Converter={StaticResource NullToVis}}"/>
                                <TextBlock Grid.Row="2" Text="Space needed" Style="{StaticResource SubText}" Margin="0,9,0,0"
                                           TextWrapping="Wrap"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SpaceEstimateText}" FontWeight="SemiBold"
                                           Margin="12,9,0,0" TextWrapping="Wrap" MaxWidth="170" HorizontalAlignment="Right"
                                           TextAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Copy options -->
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource Icon.Settings}" Style="{StaticResource GlyphIcon}"
                                           Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy Options" Style="{StaticResource SectionTitle}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox Content="Create a folder for each title" IsChecked="{Binding CreatePerTitleFolders}"
                                      Margin="0,12,0,0"/>
                            <CheckBox Content="Clean file names (Title (Year))" IsChecked="{Binding CleanFilenames}"
                                      Margin="0,10,0,0"/>
                            <CheckBox Content="Verify SHA-256 after copying" IsChecked="{Binding VerifyHashes}"
                                      Margin="0,10,0,0"/>
                            <TextBlock Text="If the file already exists" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding ConflictOptions}" SelectedIndex="{Binding ConflictIndex}"
                                      HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Border>

                    <!-- Run -->
                    <Border Style="{StaticResource CardBorder}" Padding="18" Margin="0,14,0,0">
                        <StackPanel>
                            <Button Command="{Binding StartCopyCommand}" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{StaticResource Icon.HardDrive}" Style="{StaticResource GlyphSmall}" Margin="0,0,9,0"/>
                                    <TextBlock Text="Start Copy to USB"/>
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel copy" Style="{StaticResource DangerButton}" Margin="0,9,0,0"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding CancelCopyCommand}"/>

                            <!-- Live transfer progress -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Transferring…" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding OverallPercent, StringFormat={}{0:0}%}"
                                               FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyanBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding OverallPercent, Mode=OneWay}" Maximum="100" Minimum="0"
                                             Height="7" Margin="0,8,0,0"/>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Result + status -->
                            <Border Background="{StaticResource PrimaryDimBrush}" CornerRadius="{StaticResource Radius.Tile}" Padding="12,10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding ResultSummaryText, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ResultSummaryText}" TextWrapping="Wrap" FontSize="12"/>
                            </Border>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusBarText}" Margin="2,10,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding StatusText, Converter={StaticResource NullToVis}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
