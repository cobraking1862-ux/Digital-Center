<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
    ============================================================================
    DigitalCenter 2026 design system — "Obsidian Aurora"
    ========================================
    A cinematic, layered dark experience built on Windows 11 Fluent principles:

      • Canvas        obsidian graphite with violet undertones and two ambient
                      "aurora" glows (violet top-left, cyan bottom-right) that
                      are softly blurred once, at the window level, so no item
                      ever pays for expensive effects.
      • Elevation     three translucent surface levels, each outlined with a
                      hairline light border — glass that stays readable.
      • Accent        a violet → indigo aurora gradient with cyan highlights;
                      a single accent family used with restraint.
      • Shape         ONE corner-radius scale (the Radius.* tokens below):
                      6 px small parts, 8 px controls and inputs, 10 px icon
                      tiles and artwork, 12 px cards and panels. Pills are
                      RESERVED for selected navigation tabs, small category
                      chips, switch tracks, progress/scrollbar thumbs and the
                      empty-state medallion — never for buttons, text labels,
                      status badges or icon containers, which is what made
                      long labels read as ovals.
      • Type          Segoe UI Variable with tracked uppercase eyebrows and
                      large cinematic display sizes.
      • Icons         Segoe Fluent Icons (vector) through NAMED resources —
                      no raw codepoints in screens, no emoji, one family, one
                      size scale (Glyph*), square containers.
      • Motion        short and purposeful: 120 ms taps, 180 ms hovers,
                      260 ms transitions, cubic easing.

    Every color, size and shadow is a token here. Screens compose tokens;
    they never invent their own.
    ============================================================================
    -->

    <!-- ============================================================== palette -->

    <!-- Canvas: obsidian graphite with a faint violet drift -->
    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#060609" Offset="0"/>
        <GradientStop Color="#0B0A12" Offset="0.52"/>
        <GradientStop Color="#090810" Offset="1"/>
    </LinearGradientBrush>

    <!-- Ambient aurora glows (Mica-inspired depth; window blurs these once) -->
    <RadialGradientBrush x:Key="GlowTopLeft" Center="0.06,-0.04" GradientOrigin="0.06,-0.04" RadiusX="0.85" RadiusY="0.7">
        <GradientStop Color="#6B7C3AED" Offset="0"/>
        <GradientStop Color="#007C3AED" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBottomRight" Center="1.0,1.06" GradientOrigin="1.0,1.06" RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#4D0891B2" Offset="0"/>
        <GradientStop Color="#000891B2" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowCenter" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.6" RadiusY="0.5">
        <GradientStop Color="#244C1D95" Offset="0"/>
        <GradientStop Color="#004C1D95" Offset="1"/>
    </RadialGradientBrush>

    <!-- Elevation surfaces (translucent obsidian glass) -->
    <SolidColorBrush x:Key="CardBrush"        Color="#C614121F"/>
    <SolidColorBrush x:Key="CardHoverBrush"   Color="#E61C1928"/>
    <SolidColorBrush x:Key="CardStrongBrush"  Color="#F21D1A2B"/>
    <SolidColorBrush x:Key="PanelBrush"       Color="#A6100E19"/>
    <SolidColorBrush x:Key="RailBrush"        Color="#2E120F1A"/>
    <SolidColorBrush x:Key="OverlayBrush"     Color="#D90A0912"/>
    <SolidColorBrush x:Key="CardBackgroundHover" Color="#1F8B5CF6"/>

    <LinearGradientBrush x:Key="SidebarSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#EE131020" Offset="0"/>
        <GradientStop Color="#C20E0C17" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarBackground" Color="#0E0C16"/>
    <SolidColorBrush x:Key="WindowBackground"  Color="#07070A"/>

    <!-- Accent: the aurora family -->
    <SolidColorBrush x:Key="PrimaryBrush"      Color="#8B5CF6"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"  Color="#6D28D9"/>
    <SolidColorBrush x:Key="PrimaryDimBrush"   Color="#33232135"/>
    <SolidColorBrush x:Key="CyanBrush"         Color="#22D3EE"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#668B5CF6"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A78BFA" Offset="0"/>
        <GradientStop Color="#7C3AED" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#4C1D95" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientCyan" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#22D3EE" Offset="0"/>
        <GradientStop Color="#8B5CF6" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="TextBrush"     Color="#F5F3FB"/>
    <SolidColorBrush x:Key="SubTextBrush"  Color="#A9A4BE"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="#6F6A85"/>
    <SolidColorBrush x:Key="BodySoftBrush" Color="#CDC8DE"/>

    <!-- Structure -->
    <SolidColorBrush x:Key="DividerBrush"      Color="#17FFFFFF"/>
    <SolidColorBrush x:Key="BorderLowBrush"    Color="#1FFFFFFF"/>
    <SolidColorBrush x:Key="BorderHighBrush"   Color="#38FFFFFF"/>
    <SolidColorBrush x:Key="NavActiveBrush"    Color="#2E2438"/>
    <SolidColorBrush x:Key="PosterBackground"  Color="#13111C"/>

    <!-- Status -->
    <SolidColorBrush x:Key="OkBrush"     Color="#34D399"/>
    <SolidColorBrush x:Key="WarnBrush"   Color="#FBBF24"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#FB7185"/>
    <SolidColorBrush x:Key="InfoBrush"   Color="#38BDF8"/>

    <!-- Inputs: darker and more opaque than the glass they sit in, so a field
         always reads as an inset control rather than part of the panel. -->
    <SolidColorBrush x:Key="InputBackground"      Color="#D90C0A13"/>
    <SolidColorBrush x:Key="InputBackgroundHover" Color="#EE131020"/>
    <SolidColorBrush x:Key="InputBorderBrush"     Color="#33FFFFFF"/>

    <!-- Control surfaces: raised against the cards/panels around them -->
    <SolidColorBrush x:Key="ControlBrush"        Color="#332B2540"/>
    <SolidColorBrush x:Key="ControlHoverBrush"   Color="#4D3A3358"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#2A2438"/>

    <!-- ===================================================== corner geometry
         ONE scale for the whole application: every card, control, input, icon
         container and artwork frame takes its radius from these tokens, so no
         screen can drift into its own geometry and nothing is a pill by
         accident. Radius.Pill is reserved for the shapes that are meant to be
         pills (selected navigation tabs, small category chips, switch tracks,
         progress and scrollbar thumbs, the empty-state medallion). -->
    <CornerRadius x:Key="Radius.None">0</CornerRadius>
    <CornerRadius x:Key="Radius.Xs">3</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">6</CornerRadius>
    <CornerRadius x:Key="Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">10</CornerRadius>
    <CornerRadius x:Key="Radius.Art">10</CornerRadius>
    <CornerRadius x:Key="Radius.ArtBottom">0,0,10,10</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">12</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Control metrics: one height/padding scale. Buttons keep a 34 px
         minimum height with an 8 px radius, so a short label can never turn
         the control into a capsule and a long label never gets a distorted
         background. -->
    <Thickness x:Key="ControlPadding">16,8</Thickness>
    <Thickness x:Key="ControlPaddingCompact">12,6</Thickness>
    <sys:Double x:Key="ControlMinHeight">34</sys:Double>
    <sys:Double x:Key="IconTileSize">44</sys:Double>
    <sys:Double x:Key="IconChipSize">34</sys:Double>

    <!-- ============================================================ shadows -->
    <DropShadowEffect x:Key="ShadowCard"     BlurRadius="14" ShadowDepth="3"  Direction="270" Opacity="0.38" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowPanel"    BlurRadius="20" ShadowDepth="5"  Direction="270" Opacity="0.44" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowElevated" BlurRadius="30" ShadowDepth="9"  Direction="270" Opacity="0.52" Color="#000000"/>
    <DropShadowEffect x:Key="ShadowAccent"   BlurRadius="22" ShadowDepth="0"  Direction="270" Opacity="0.45" Color="#7C3AED"/>
    <DropShadowEffect x:Key="ShadowCyan"     BlurRadius="22" ShadowDepth="0"  Direction="270" Opacity="0.35" Color="#22D3EE"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ========================================================== typography -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>

    <!-- Tracked uppercase micro-label above page/section titles -->
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="46"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource SubText}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource BodySoftBrush}"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <Style x:Key="AppTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

