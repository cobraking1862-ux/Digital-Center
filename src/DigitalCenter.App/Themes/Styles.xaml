<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
    ============================================================================
    DigitalCenter design system — "Aurora Light"
    ==========================================
    A bright, calm, high-contrast experience on Windows 11 Fluent principles:

      • Canvas        violet-tinted white with two very soft ambient glows
                      (violet top-left, cyan bottom-right), blurred once at the
                      window level, so no item ever pays for effects.
      • Elevation     opaque white surfaces separated by hairline borders and
                      soft violet-grey shadows — no translucent glass, because
                      on a light canvas depth reads better from edges.
      • Accent        one violet family (#6D28D9 → #5B21B6) with a dark cyan
                      highlight (#0E7490). Accent fills stay saturated so white
                      glyphs and labels on them keep ≥ 4.5:1 contrast.
      • Contrast      every text token is WCAG AA or better on the surface it
                      is used on: body #1B1726 (~16:1), secondary #554F6B
                      (~7.6:1), tertiary #7A7490 (~4.6:1), accent #6D28D9
                      (~7:1), cyan #0E7490 (~5:1), status colors ~4.8–6:1.
                      The *SoftBrush status tints are the chip backgrounds that
                      go with them.
      • Shape         ONE rectangular radius scale (the Radius.* tokens): 2 px
                      hairline parts, 4 px small, 6 px controls, 8 px tiles and
                      artwork, 10 px cards. No pills anywhere — the largest
                      radius stays well below half the smallest control height.
      • Type          Segoe UI Variable, tracked uppercase eyebrows, large
                      display sizes.
      • Icons         Segoe Fluent Icons through NAMED resources (Icon.*): no
                      raw codepoints in screens, no emoji, one family, one size
                      scale (Glyph*), square containers.
      • Motion        short and purposeful: 120 ms taps, 180 ms hovers,
                      260 ms transitions, cubic easing.

    Every color, size and shadow is a token here. Screens compose tokens; they
    never invent their own. The few literal colors left in screens are content
    colors — scrims and text over poster/backdrop artwork, which stay dark so
    they remain legible over arbitrary images.
    ============================================================================
    -->

    <!-- ============================================================== palette
         "Aurora Light": the same design language as before (violet accent,
         cyan highlight, one rectangular geometry, Segoe Fluent glyphs) but on a
         bright canvas. Every surface is opaque white or a violet-tinted off-white,
         every text token is dark enough for WCAG AA on those surfaces, and the
         accent stays saturated so white glyphs on accent fills keep their
         contrast. Screens compose these tokens; they never invent colors. -->

    <!-- Canvas: soft violet-tinted white -->
    <LinearGradientBrush x:Key="WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FBFAFF" Offset="0"/>
        <GradientStop Color="#F3F1FA" Offset="0.52"/>
        <GradientStop Color="#F7F5FC" Offset="1"/>
    </LinearGradientBrush>

    <!-- Ambient glows: barely-there violet/cyan tints on a light canvas -->
    <RadialGradientBrush x:Key="GlowTopLeft" Center="0.06,-0.04" GradientOrigin="0.06,-0.04" RadiusX="0.85" RadiusY="0.7">
        <GradientStop Color="#1F7C3AED" Offset="0"/>
        <GradientStop Color="#007C3AED" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowBottomRight" Center="1.0,1.06" GradientOrigin="1.0,1.06" RadiusX="0.9" RadiusY="0.75">
        <GradientStop Color="#170891B2" Offset="0"/>
        <GradientStop Color="#000891B2" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowCenter" Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.6" RadiusY="0.5">
        <GradientStop Color="#0F4C1D95" Offset="0"/>
        <GradientStop Color="#004C1D95" Offset="1"/>
    </RadialGradientBrush>

    <!-- Elevation surfaces: opaque whites and tinted off-whites (no glass on a
         light canvas — depth comes from borders and soft shadows instead) -->
    <SolidColorBrush x:Key="CardBrush"           Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CardHoverBrush"      Color="#FDFAFF"/>
    <SolidColorBrush x:Key="CardStrongBrush"     Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="PanelBrush"          Color="#FCFBFE"/>
    <SolidColorBrush x:Key="CardBackgroundHover" Color="#146D28D9"/>

    <LinearGradientBrush x:Key="SidebarSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#F4F1FB" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="WindowBackground"  Color="#F3F1F9"/>

    <!-- Accent: the aurora family, darkened for a light canvas -->
    <SolidColorBrush x:Key="PrimaryBrush"      Color="#6D28D9"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush"  Color="#5B21B6"/>
    <SolidColorBrush x:Key="PrimaryDimBrush"   Color="#146D28D9"/>
    <SolidColorBrush x:Key="CyanBrush"         Color="#0E7490"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#4D6D28D9"/>
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D28D9" Offset="0"/>
        <GradientStop Color="#5B21B6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientSoft" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientCyan" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0E7490" Offset="0"/>
        <GradientStop Color="#6D28D9" Offset="1"/>
    </LinearGradientBrush>

    <!-- Text: AA or better on every surface token above -->
    <SolidColorBrush x:Key="TextBrush"      Color="#1B1726"/>
    <SolidColorBrush x:Key="SubTextBrush"   Color="#554F6B"/>
    <SolidColorBrush x:Key="FaintTextBrush" Color="#7A7490"/>
    <SolidColorBrush x:Key="BodySoftBrush"  Color="#35304A"/>
    <SolidColorBrush x:Key="OnAccentBrush"  Color="#FFFFFF"/>

    <!-- Structure -->
    <SolidColorBrush x:Key="DividerBrush"      Color="#1A1B1726"/>
    <SolidColorBrush x:Key="BorderLowBrush"    Color="#241B1726"/>
    <SolidColorBrush x:Key="BorderHighBrush"   Color="#3D1B1726"/>
    <SolidColorBrush x:Key="NavActiveBrush"    Color="#EDE7FB"/>

    <!-- Status: dark enough to read as text on white; the *Soft variants are
         the chip/badge backgrounds that go with them. -->
    <SolidColorBrush x:Key="OkBrush"         Color="#15803D"/>
    <SolidColorBrush x:Key="WarnBrush"       Color="#B45309"/>
    <SolidColorBrush x:Key="DangerBrush"     Color="#B91C1C"/>
    <SolidColorBrush x:Key="OkSoftBrush"     Color="#E6F6EC"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FBEAEA"/>

    <!-- Inputs: white and crisply bordered so a field reads as an inset control -->
    <SolidColorBrush x:Key="InputBackground"      Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="InputBackgroundHover" Color="#FCFAFF"/>
    <SolidColorBrush x:Key="InputBorderBrush"     Color="#331B1726"/>

    <!-- Control surfaces: tinted greys that sit quietly inside white cards -->
    <SolidColorBrush x:Key="ControlBrush"        Color="#F2EFF9"/>
    <SolidColorBrush x:Key="ControlHoverBrush"   Color="#E7E1F6"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#DCD4F0"/>

    <!-- Placeholder artwork: what an empty poster/frame looks like -->
    <SolidColorBrush x:Key="PlaceholderGlyphBrush" Color="#B9B2CC"/>

    <!-- ===================================================== corner geometry
         ONE rectangular scale for the whole application: every card, control,
         input, tab, chip, badge, icon container and artwork frame takes its
         radius from these tokens, so no screen can drift into its own geometry.
         Nothing is a capsule: the old 999 px "pill" radius is gone, and the
         largest radius in the application (Radius.Card, 10 px) is well below
         half of the smallest control height, so no element can read as an oval
         whatever its content is. -->
    <CornerRadius x:Key="Radius.Xs">2</CornerRadius>
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Tile">8</CornerRadius>
    <CornerRadius x:Key="Radius.Art">8</CornerRadius>
    <CornerRadius x:Key="Radius.ArtBottom">0,0,8,8</CornerRadius>
    <CornerRadius x:Key="Radius.Card">10</CornerRadius>
    <CornerRadius x:Key="Radius.Popup">10</CornerRadius>

    <!-- Layout metrics: every screen uses the same outer margin and the same
         card padding, so pages line up with each other when you switch. -->
    <Thickness x:Key="PageMargin">28,20,28,20</Thickness>
    <Thickness x:Key="CardPadding">20</Thickness>
    <Thickness x:Key="CardPaddingCompact">16</Thickness>
    <Thickness x:Key="CardHeaderPadding">20,16,20,12</Thickness>

    <!-- Control metrics: one height/padding scale. Buttons keep a 34 px
         minimum height with an 8 px radius, so a short label can never turn
         the control into a capsule and a long label never gets a distorted
         background. -->
    <Thickness x:Key="ControlPadding">16,8</Thickness>
    <Thickness x:Key="ControlPaddingCompact">12,6</Thickness>
    <sys:Double x:Key="ControlMinHeight">34</sys:Double>
    <sys:Double x:Key="IconTileSize">48</sys:Double>
    <sys:Double x:Key="IconChipSize">34</sys:Double>

    <!-- ============================================================ shadows -->
    <DropShadowEffect x:Key="ShadowCard"     BlurRadius="14" ShadowDepth="2"  Direction="270" Opacity="0.10" Color="#1B1726"/>
    <DropShadowEffect x:Key="ShadowElevated" BlurRadius="30" ShadowDepth="6"  Direction="270" Opacity="0.16" Color="#1B1726"/>
    <DropShadowEffect x:Key="ShadowAccent"   BlurRadius="18" ShadowDepth="0"  Direction="270" Opacity="0.20" Color="#6D28D9"/>

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Display, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ========================================================== typography -->
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Background" Value="{StaticResource WindowBackground}"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="FontSize" Value="13.5"/>
    </Style>

    <!-- Tracked uppercase micro-label above page/section titles -->
    <Style x:Key="EyebrowText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
        <Setter Property="Typography.Capitals" Value="AllSmallCaps"/>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="HeroTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="40"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="LineHeight" Value="46"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Title of a nested area (a settings category, the metadata editor):
         between SectionTitle and PageTitle, and the same everywhere. -->
    <Style x:Key="SubPageTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SubText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
    </Style>

    <Style x:Key="CaptionText" TargetType="TextBlock" BasedOn="{StaticResource SubText}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource BodySoftBrush}"/>
        <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <Style x:Key="AppTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="14.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="StatValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- ================================================================ icons
         Named Segoe Fluent Icons glyphs. One family, consistent weight, no
         emoji anywhere. Screens reference Icon.* keys, never raw codepoints. -->
    <sys:String x:Key="Icon.Hamburger">&#xE700;</sys:String>
    <sys:String x:Key="Icon.Search">&#xE721;</sys:String>
    <sys:String x:Key="Icon.Clear">&#xE711;</sys:String>
    <sys:String x:Key="Icon.Add">&#xE710;</sys:String>
    <sys:String x:Key="Icon.Remove">&#xE738;</sys:String>
    <sys:String x:Key="Icon.Delete">&#xE74D;</sys:String>
    <sys:String x:Key="Icon.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Icon.Back">&#xE76B;</sys:String>
    <sys:String x:Key="Icon.Next">&#xE76C;</sys:String>
    <sys:String x:Key="Icon.ChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="Icon.Home">&#xE80F;</sys:String>
    <sys:String x:Key="Icon.Cart">&#xE7BF;</sys:String>
    <sys:String x:Key="Icon.Library">&#xE8F1;</sys:String>
    <sys:String x:Key="Icon.Settings">&#xE713;</sys:String>
    <sys:String x:Key="Icon.Edit">&#xE70F;</sys:String>
    <sys:String x:Key="Icon.Save">&#xE74E;</sys:String>
    <sys:String x:Key="Icon.Refresh">&#xE72C;</sys:String>
    <sys:String x:Key="Icon.Folder">&#xE8B5;</sys:String>
    <sys:String x:Key="Icon.FolderOpen">&#xE838;</sys:String>
    <sys:String x:Key="Icon.Film">&#xE8B6;</sys:String>
    <sys:String x:Key="Icon.Tv">&#xE7F4;</sys:String>
    <sys:String x:Key="Icon.Play">&#xE768;</sys:String>
    <sys:String x:Key="Icon.Stop">&#xE71A;</sys:String>
    <sys:String x:Key="Icon.ExternalLink">&#xE8A7;</sys:String>
    <sys:String x:Key="Icon.Info">&#xE946;</sys:String>
    <sys:String x:Key="Icon.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Icon.Error">&#xE783;</sys:String>
    <sys:String x:Key="Icon.Download">&#xE896;</sys:String>
    <sys:String x:Key="Icon.Copy">&#xE8C8;</sys:String>
    <sys:String x:Key="Icon.People">&#xE716;</sys:String>
    <sys:String x:Key="Icon.Person">&#xE77B;</sys:String>
    <sys:String x:Key="Icon.History">&#xE81C;</sys:String>
    <sys:String x:Key="Icon.Cloud">&#xE753;</sys:String>
    <sys:String x:Key="Icon.HardDrive">&#xEDA2;</sys:String>
    <sys:String x:Key="Icon.Diagnostic">&#xE9D9;</sys:String>
    <sys:String x:Key="Icon.OpenFile">&#xE8E5;</sys:String>
    <sys:String x:Key="Icon.Shield">&#xEA18;</sys:String>
    <sys:String x:Key="Icon.Font">&#xE8D2;</sys:String>
    <sys:String x:Key="Icon.Sync">&#xE895;</sys:String>
    <sys:String x:Key="Icon.Scan">&#xE8FE;</sys:String>
    <!-- Window caption glyphs: no raw codepoints anywhere in the app -->
    <sys:String x:Key="Icon.Minimize">&#xE921;</sys:String>
    <sys:String x:Key="Icon.Maximize">&#xE922;</sys:String>
    <sys:String x:Key="Icon.Restore">&#xE923;</sys:String>
    <sys:String x:Key="Icon.Close">&#xE8BB;</sys:String>

    <!-- ONE icon size scale (12 / 14 / 16 / 20 / 26 / 34). Screens pick a step
         instead of setting an ad-hoc FontSize, so every glyph is proportioned
         the same way relative to the control that carries it. -->
    <Style x:Key="GlyphIcon" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>
    <Style x:Key="GlyphXs" TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
        <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="GlyphSmall" TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style x:Key="GlyphMedium" TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
        <Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="GlyphLarge" TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
        <Setter Property="FontSize" Value="26"/>
    </Style>
    <Style x:Key="GlyphHero" TargetType="TextBlock" BasedOn="{StaticResource GlyphIcon}">
        <Setter Property="FontSize" Value="34"/>
    </Style>

    <!-- Accent icon tile for page headers and stat cards: a SQUARE tile with the
         tile radius — never a circle or an oval. -->
    <Style x:Key="IconTile" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconTileSize}"/>
        <Setter Property="Height" Value="{StaticResource IconTileSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
        <Setter Property="Background" Value="{StaticResource AccentGradientSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource ShadowAccent}"/>
    </Style>

    <!-- Quiet icon chip: small rounded square behind an inline glyph -->
    <Style x:Key="IconChip" TargetType="Border">
        <Setter Property="Width" Value="{StaticResource IconChipSize}"/>
        <Setter Property="Height" Value="{StaticResource IconChipSize}"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
        <Setter Property="Background" Value="{StaticResource PrimaryDimBrush}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- ============================================================== tooltips -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{StaticResource CardStrongBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="HasDropShadow" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="{StaticResource Radius.Tile}" Padding="12,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.16" Color="#1B1726"/>
                        </Border.Effect>
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== buttons -->
    <!-- Primary action: aurora gradient with a soft violet glow on hover. The
         control radius is fixed by the token and the height has a floor, so a
         short label ("OK") and a long one ("Start Monitoring") both stay a
         properly proportioned rounded rectangle. -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform Y="0"/>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="-1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryDarkBrush}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}"/>
                            <Setter TargetName="Chrome" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform Y="1"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource FaintTextBrush}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary: a raised CONTROL surface (ControlBrush, not the panel's
         CardBrush) with a hairline border and an accent border on hover, so it
         always reads as something you can press rather than as part of the
         panel it sits on. -->
    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource BorderLowBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ghost: text-quiet, tint fill on hover -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPaddingCompact}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardBackgroundHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Danger: rose outline that fills on hover -->
    <Style x:Key="DangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPadding}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#59B91C1C"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DangerBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowCard}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#EBD3D3"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Square icon button (rounded corners, never a circle) with a hover fill -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Width" Value="34"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource Radius.Tile}"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardBackgroundHover}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Caption-bar (title bar) buttons -->
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#14000000"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#1F000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#E81123"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#B0001A"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ chips -->
    <Style x:Key="GenreChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Xs}"/>
        <Setter Property="Padding" Value="9,3"/>
    </Style>

    <Style x:Key="MiniChipText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource BodySoftBrush}"/>
    </Style>

    <!-- Selectable filter chip (genre browser) -->
    <Style x:Key="ChipToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource ControlHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== badges -->
    <!-- Type label pinned over posters. Badges are NOT pills: a long value
         ("DOCUMENTARY") inside a 999 px radius reads as a distorted oval, so
         they take the small radius instead. -->
    <Style x:Key="TypeBadge" TargetType="Border">
        <Setter Property="Background" Value="#D91B1726"/>
        <Setter Property="BorderBrush" Value="#40FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="9,3"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="10,10,0,0"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
    </Style>

    <!-- Status chip: small radius (never a pill) so long statuses such as
         "Awaiting destination" keep a calm rectangular background. -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ControlBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Sm}"/>
        <Setter Property="Padding" Value="11,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="AvailabilityDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ======================================================== toggle switch -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Track"
                                Width="42" Height="22" CornerRadius="{StaticResource Radius.Sm}"
                                Background="#2E1B1726"
                                BorderBrush="{StaticResource BorderHighBrush}"
                                BorderThickness="1">
                            <Border x:Name="Knob"
                                    Width="14" Height="14"
                                    CornerRadius="{StaticResource Radius.Xs}"
                                    Background="{StaticResource SubTextBrush}"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                          RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Track" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter TargetName="Knob" Property="Background" Value="White"/>
                            <Setter TargetName="Knob" Property="Margin" Value="23,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- =============================================================== inputs -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBorderBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPaddingCompact}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Search field: an input, so it takes the control radius (36 px tall) —
         a pill here stretched the background under long query text. -->
    <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="Padding" Value="40,8,34,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Chrome"
                            Background="{StaticResource InputBackground}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBackgroundHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox: glass popup, rounded field, chevron affordance -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}" Margin="6,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryDimBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
        <Setter Property="Padding" Value="{StaticResource ControlPaddingCompact}"/>
        <Setter Property="MinHeight" Value="{StaticResource ControlMinHeight}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
        <Setter Property="MaxDropDownHeight" Value="360"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="ToggleButton"
                                      Focusable="False"
                                      ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Chrome"
                                            Background="{StaticResource InputBackground}"
                                            BorderBrush="{StaticResource InputBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource Radius.Control}">
                                        <TextBlock Text="{StaticResource Icon.ChevronDown}"
                                                   Style="{StaticResource GlyphXs}" Margin="0,1,11,0"
                                                   Foreground="{StaticResource FaintTextBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource InputBackgroundHover}"/>
                                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Border x:Name="ChromeOverlay" Background="Transparent" CornerRadius="{StaticResource Radius.Control}"
                                Margin="0,0,26,0" IsHitTestVisible="False"/>
                        <ContentPresenter x:Name="Selected"
                                          IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Left"/>
                        <Popup x:Name="PART_Popup"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource CardStrongBrush}"
                                    BorderBrush="{StaticResource BorderLowBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius.Popup}"
                                    Margin="12,6,12,14"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.18" Color="#1B1726"/>
                                </Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,5">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Border x:Name="Box"
                                Width="19" Height="19" CornerRadius="{StaticResource Radius.Sm}"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource BorderHighBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CheckGlyph" Text="{StaticResource Icon.Check}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10.5" Foreground="{StaticResource OnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0" RecognizesAccessKey="True"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Track x:Name="PART_Track" Value="{TemplateBinding Value}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" CornerRadius="{StaticResource Radius.Xs}"
                                                    Background="{StaticResource AccentGradientCyan}"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="5" CornerRadius="{StaticResource Radius.Xs}"
                                                    Background="#1F1B1726"/>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="17" Height="17" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Width="15" Height="15" CornerRadius="{StaticResource Radius.Xs}"
                                                    Background="White" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="3">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.25" Color="#6D28D9"/>
                                                </Border.Effect>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ list & tabs -->
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- Maintenance/Reports section tabs: rectangular segments -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="16,7"
                            Margin="0,0,6,0">
                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True"/>
                                <Condition Property="IsSelected" Value="False"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CardHoverBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================ scrollbar -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#4D1B1726" CornerRadius="{StaticResource Radius.Xs}" Margin="2.5,0"
                                                    Cursor="Hand"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#0A000000"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#4D1B1726" CornerRadius="{StaticResource Radius.Xs}" Margin="0,2.5"
                                                            Cursor="Hand"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ======================================================== navigation -->
    <!-- Sidebar item: rounded rectangle row (control geometry, not a pill —
         a pill on a full-width row turns long labels into ovals) -->
    <Style x:Key="NavListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="12,2"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Tile}"
                            Padding="10,9">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#141B1726"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource NavActiveBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource PrimaryDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================== cards -->
    <!-- Standard content card: level-2 glass, card radius from the token -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="{StaticResource CardPadding}"/>
        <Setter Property="Effect" Value="{StaticResource ShadowCard}"/>
    </Style>

    <!-- Floating glass panel (level 3, details/preview side rails) -->

    <!-- Stat tile with an icon chip and accent value -->
    <!-- StatCard is gone: the Management dashboard now shows ONE consolidated
         Import Summary card (CardBorder) instead of six separate tiles. -->

    <!-- ============================================================= posters -->
    <Style x:Key="PosterPlaceholder" TargetType="Border">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#F1EDF9" Offset="0"/>
                    <GradientStop Color="#E6E0F2" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Art}"/>
    </Style>

    <!-- Poster card: hover lift + zoom + accent ring (transform is animated
         by the card template). No resting Effect on purpose: hundreds of
         cards stay cheap to render; the accent glow is applied only on hover. -->
    <Style x:Key="PosterCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Card}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
    </Style>

    <!-- Empty-state medallion: ringed rounded square holding one large glyph -->
    <Style x:Key="EmptyMedallion" TargetType="Border">
        <Setter Property="Width" Value="84"/>
        <Setter Property="Height" Value="84"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Tile}"/>
        <Setter Property="Background" Value="{StaticResource PrimaryDimBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ========================================================== progress -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="#1F1B1726"/>
        <Setter Property="Foreground" Value="{StaticResource AccentGradientCyan}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Xs}"/>
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                CornerRadius="{StaticResource Radius.Xs}" HorizontalAlignment="Left"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsIndeterminate" Value="True">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0E7490" Offset="0"/>
                            <GradientStop Color="#6D28D9" Offset="0.5"/>
                            <GradientStop Color="#7C3AED" Offset="1"/>
                        </LinearGradientBrush>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- =========================================================== sections -->
    <Style x:Key="Divider" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource DividerBrush}"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="0,14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Background="{TemplateBinding Background}" Height="1"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Quiet footer/status text row -->

    <!-- Segmented navigation: rectangular radio segments inside a rectangular
         glass track (renamed from CapsuleTrack — nothing is a capsule any more) -->
    <Style x:Key="SegmentedTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource InputBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderLowBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Control}"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="TopNavRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="Transparent"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Padding="18,8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#141B1726"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentGradient}"/>
                            <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource ShadowAccent}"/>
                            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page entrance: short opacity fade applied to each page instance.
         Keyed style, set on the view inside the shell's DataTemplates — an
         implicit UserControl style would not match derived page types.
         Opacity only: cheap for large pages, acceptable under reduced motion. -->
    <Style x:Key="PageFadeStyle" TargetType="UserControl">
        <Style.Triggers>
            <EventTrigger RoutedEvent="UserControl.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0" To="1" Duration="0:0:0.18"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
