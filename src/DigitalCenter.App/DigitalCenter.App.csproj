<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Allows compiling the WPF executable on non-Windows build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>DigitalCenter.App</RootNamespace>
    <AssemblyName>DigitalCenter</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>DigitalCenter</Product>
    <Description>DigitalCenter - local media catalog and USB copy manager.</Description>
    <!-- Used by `dotnet user-secrets` to supply the TMDb read token in development. -->
    <UserSecretsId>2f6b4a1c-6f2e-4f3a-9a33-digitalcenter-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DigitalCenter.Core\DigitalCenter.Core.csproj" />
    <ProjectReference Include="..\DigitalCenter.ViewModels\DigitalCenter.ViewModels.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Deployment configuration: operators may place the TMDb read token
         here (Tmdb:ReadAccessToken). Never commit real credentials. -->
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
