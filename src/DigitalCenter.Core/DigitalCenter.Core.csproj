<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>DigitalCenter.Core</RootNamespace>
    <Description>DigitalCenter domain, data access and services (platform-independent).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Explicit pin: transitive 2.1.11 has a known high-severity vulnerability (NU1903). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.*" />
    <!-- Explicit pin: transitive 9.0.0 has a known high-severity vulnerability (NU1903). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.*" />
  </ItemGroup>

</Project>
