## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
publish/
publish-smoke/

# Visual Studio cache/options
.vs/
.idea/

# .NET CLI
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/
*.nuget.props
*.nuget.targets

# Test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
TestResults/

# Databases and local artifacts
*.db
*.db-shm
*.db-wal
*.pre-restore-*

# Rider/VS Code
*.sln.iml
.vscode/

# OS
.DS_Store
Thumbs.db
