; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!
; Non-commercial use only

#define MyAppName "CBA Explorer"
#define MyAppVersion "14.0.0"
#define MyAppPublisher "Muhammad Masoom, Inc."
#define MyAppURL "https://cbajoker.github.io/Portfolio/"
#define MyAppExeName "DigitalCenter.exe"
#define PublishDir "D:\Dev_Home\Github\CBA Explorer\CBA Movie Explorer\src\DigitalCenter.App\bin\Release\net10.0-windows\win-x64\publish"
#define InstallerDataDir "D:\Dev_Home\Github\CBA Explorer\installer Data"

[Setup]
; Keep AppId unchanged so updates install in place without uninstalling.
AppId={{B90B4AF4-961B-4CE2-AA35-0DA0EA7AA1BD}
AppName={#MyAppName}
AppVersion={#MyAppVersion}
AppPublisher={#MyAppPublisher}
AppPublisherURL={#MyAppURL}
AppSupportURL={#MyAppURL}
AppUpdatesURL={#MyAppURL}
DefaultDirName={autopf}\{#MyAppName}
UninstallDisplayIcon={app}\{#MyAppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DisableProgramGroupPage=yes
CloseApplications=yes
CloseApplicationsFilter=*.exe
LicenseFile={#InstallerDataDir}\license_file.txt
InfoBeforeFile={#InstallerDataDir}\before_installation_file.txt
InfoAfterFile={#InstallerDataDir}\after_installation_file.txt
;PrivilegesRequired=lowest
OutputDir=D:\Dev_Home\Github\CBA Explorer\Installer Version
OutputBaseFilename=CBAExplorerSetup-{#MyAppVersion}
SetupIconFile={#InstallerDataDir}\CBAExplorer.ico
SolidCompression=yes
WizardStyle=modern windows11

[Languages]
Name: "english" MessagesFile: "compiler:Default.isl"

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Flags: unchecked

[InstallDelete]
; Remove leftover Sample data folder from older installations without touching user data in %APPDATA%\DigitalCenter
Type: filesandordirs; Name: "{app}\Sample data"

[Files]
Source: "{#PublishDir}\*"; DestDir: "{app}"; Excludes: "*.pdb"; Flags: ignoreversion recursesubdirs createallsubdirs

[Icons]
Name: "{autoprograms}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"
Name: "{autodesktop}\{#MyAppName}"; Filename: "{app}\{#MyAppExeName}"; Tasks: desktopicon

[Run]
Filename: "{app}\{#MyAppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(MyAppName, '&', '&&')}}"; Flags: nowait postinstall skipifsilent
